---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import LinkList from "../components/LinkList.astro";
import { profile } from "../data/profile";
interface Props {
  entry: CollectionEntry<"research">;
  publication?: CollectionEntry<"publications">;
}
const {
  entry: { data, id },
  publication,
} = Astro.props;
const pub = publication?.data;
const article = pub
  ? {
      "@context": "https://schema.org",
      "@type": "ScholarlyArticle",
      headline: pub.title,
      author: pub.authors.map((name) => ({ "@type": "Person", name })),
      datePublished: pub.date.toISOString().slice(0, 10),
      url: pub.links.find((link) => link.label === "Paper")?.href,
      isAccessibleForFree: true,
    }
  : undefined;
---

<BaseLayout title={data.title} description={data.summary}>
  <Fragment slot="head">
    {
      pub && (
        <>
          <meta name="citation_title" content={pub.title} />
          {pub.authors.map((author) => (
            <meta name="citation_author" content={author} />
          ))}
          <meta
            name="citation_publication_date"
            content={pub.date.toISOString().slice(0, 10)}
          />
          {pub.pdf && <meta name="citation_pdf_url" content={pub.pdf} />}
          <meta name="citation_arxiv_id" content={pub.arxiv} />
          <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(article).replace(/</g, "\\u003c")}
          />
        </>
      )
    }
  </Fragment>

  <header class="research-header study-panel">
    <div class="folio-top-bar">
      <a class="breadcrumb" href="/research/">← Return to Research Wing</a>
      <span class="call-stamp">
        STUDY PLATE // {id.toUpperCase()} · {data.date.getUTCFullYear()}
      </span>
    </div>

    <p class="eyebrow accent">{data.category}</p>
    <h1>{data.title}</h1>
    <p class="research-dek">{data.summary}</p>
    <p class="research-authors">
      {
        data.authors.map((author, i) => (
          <>
            {i > 0 && ", "}
            {author === profile.name ? <strong>{author}</strong> : author}
          </>
        ))
      }
    </p>
    <div class="meta-bar">
      <span class="brass-tag teal">
        {data.status} · {data.date.getUTCFullYear()}
        {data.venue && ` · ${data.venue}`}
      </span>
      <LinkList links={data.links} context={data.title} />
    </div>
    <p class="tagline">{data.tags.join(" · ")}</p>
  </header>

  {
    data.image && (
      <figure class="research-figure">
        <div class="figure-matting">
          <Image src={data.image} alt={data.imageAlt!} loading="eager" />
        </div>
        {data.figureCaption && <figcaption>{data.figureCaption}</figcaption>}
      </figure>
    )
  }

  <div class="prose">
    <slot />
    {
      pub?.bibtex && (
        <section aria-label="Citation">
          <h2>Citation</h2>
          <details open>
            <summary>BibTeX for {pub.title}</summary>
            <pre><code>{pub.bibtex}</code></pre>
          </details>
        </section>
      )
    }
    <div class="research-back">
      <a href="/research/">← Return to Research Wing</a>
    </div>
  </div>
</BaseLayout>

<style>
  .research-header {
    padding: 1.5rem 2.5rem 2.25rem;
    margin-block: 2.25rem 2rem;
  }

  .folio-top-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.85rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--heading);
  }

  .call-stamp {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .research-header .eyebrow {
    color: var(--accent-strong);
    margin-bottom: 0.75rem;
  }

  .research-header h1 {
    font-size: clamp(2.25rem, 4.4vw, 3.85rem);
    line-height: 1.08;
  }

  .research-dek {
    font-size: 1.08rem;
    color: var(--text-muted);
    margin-top: 1.15rem;
    max-width: 66ch;
  }

  .research-authors {
    font-size: 0.88rem;
    margin-top: 1.15rem;
    color: var(--text-muted);
  }

  .research-authors strong {
    font-weight: 600;
    color: var(--heading);
    text-decoration: underline;
    text-decoration-color: var(--brass);
    text-underline-offset: 3px;
  }

  .meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 0.85rem;
  }

  .research-figure {
    max-width: 920px;
    margin: 0 auto;
    padding: 0.9rem;
    background: linear-gradient(145deg, #4a3020, #2b1b11);
    border: 2px solid var(--brass);
    border-radius: 6px;
    box-shadow: var(--card-shadow);
  }

  .figure-matting {
    background: #faf8ef;
    padding: 0.5rem;
    border: 1px solid #c49240;
    border-radius: 3px;
  }

  .research-figure img {
    width: 100%;
    border-radius: 2px;
  }

  .research-figure figcaption {
    max-width: 75ch;
    margin-top: 0.75rem;
    padding-inline: 0.35rem;
    color: #f2cc8f;
    font-family: var(--font-mono);
    font-size: 0.73rem;
    line-height: 1.55;
  }

  .research-back {
    margin-top: 2.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-strong);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .research-header {
      padding: 1.25rem 1.25rem 1.75rem;
      margin-top: 1.5rem;
    }
    .research-dek {
      font-size: 0.98rem;
    }
  }
</style>
