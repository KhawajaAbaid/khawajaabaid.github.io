---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import LinkList from "../components/LinkList.astro";
import { profile } from "../data/profile";
interface Props {
  entry: CollectionEntry<"research">;
  publication?: CollectionEntry<"publications">;
}
const {
  entry: { data },
  publication,
} = Astro.props;
const pub = publication?.data;
const article = pub
  ? {
      "@context": "https://schema.org",
      "@type": "ScholarlyArticle",
      headline: pub.title,
      author: pub.authors.map((name) => ({ "@type": "Person", name })),
      datePublished: pub.date.toISOString().slice(0, 10),
      url: pub.links.find((link) => link.label === "Paper")?.href,
      isAccessibleForFree: true,
    }
  : undefined;
---

<BaseLayout title={data.title} description={data.summary}>
  <Fragment slot="head"
    >{
      pub && (
        <>
          <meta name="citation_title" content={pub.title} />
          {pub.authors.map((author) => (
            <meta name="citation_author" content={author} />
          ))}
          <meta
            name="citation_publication_date"
            content={pub.date.toISOString().slice(0, 10)}
          />
          {pub.pdf && <meta name="citation_pdf_url" content={pub.pdf} />}
          <meta name="citation_arxiv_id" content={pub.arxiv} />
          <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(article).replace(/</g, "\\u003c")}
          />
        </>
      )
    }</Fragment
  >
  <header class="research-header">
    <a class="breadcrumb" href="/research/">← Research</a><p
      class="eyebrow accent"
    >
      {data.category}
    </p><h1>{data.title}</h1><p class="research-dek">{data.summary}</p><p
      class="research-authors"
    >
      {
        data.authors.map((author, i) => (
          <>
            {i > 0 && ", "}
            {author === profile.name ? <strong>{author}</strong> : author}
          </>
        ))
      }
    </p><p class="research-meta">
      {data.status} · {data.date.getUTCFullYear()}{
        data.venue && ` · ${data.venue}`
      }
    </p><LinkList links={data.links} context={data.title} /><p class="tagline">
      {data.tags.join(" · ")}
    </p>
  </header>
  {
    data.image && (
      <figure class="research-figure">
        <Image src={data.image} alt={data.imageAlt!} loading="eager" />
        {data.figureCaption && <figcaption>{data.figureCaption}</figcaption>}
      </figure>
    )
  }
  <div class="prose">
    <slot />{
      pub?.bibtex && (
        <section aria-label="Citation">
          <>
            <h2>Citation</h2>
            <details>
              <>
                <summary>BibTeX for {pub.title}</summary>
                <pre>
                  <code>{pub.bibtex}</code>
                </pre>
              </>
            </details>
          </>
        </section>
      )
    }<div class="research-back"><a href="/research/">← All research</a></div>
  </div>
</BaseLayout>
<style>
  .research-header {
    padding-block: 3rem;
    max-width: 980px;
  }
  .breadcrumb {
    font-size: 0.8rem;
    display: inline-block;
    margin-bottom: 3rem;
  }
  .research-header .eyebrow {
    color: var(--accent-strong);
    margin-bottom: 1.5rem;
  }
  .research-header h1 {
    font-size: clamp(2.8rem, 5.5vw, 5rem);
    line-height: 1.08;
  }
  .research-dek {
    font-size: 1.2rem;
    color: var(--text-muted);
    margin-top: 2rem;
    max-width: 66ch;
  }
  .research-authors {
    font-size: 0.85rem;
    margin-top: 1.8rem;
    color: var(--text-muted);
  }
  .research-authors strong {
    font-weight: 500;
    color: var(--text);
  }
  .research-meta {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }
  .research-header :global(.links) {
    margin-top: 0.7rem;
  }
  .research-header .tagline {
    font-size: 0.7rem;
  }
  .research-figure {
    max-width: 900px;
    margin: 0 auto;
  }
  .research-figure img {
    width: 100%;
    border-radius: 5px;
  }
  .research-figure figcaption {
    max-width: 75ch;
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.75rem;
  }
  .research-back {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }
  @media (max-width: 720px) {
    .research-header {
      padding-top: 2rem;
    }
    .breadcrumb {
      margin-bottom: 2rem;
    }
    .research-dek {
      font-size: 1.05rem;
    }
    .research-figure {
      margin-bottom: 1.5rem;
    }
  }
</style>
