---
import "../styles/global.css";
import "../styles/print.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = profile.description,
  noindex = false,
} = Astro.props;

const pageTitle = title
  ? `${title} — ${profile.name}`
  : `${profile.name} — Multi-Agent Coordination & ML Software`;

const canonical = new URL(
  noindex ? "/404.html" : Astro.url.pathname,
  Astro.site,
);

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: Astro.site?.href,
  jobTitle: profile.role,
  description: profile.description,
  knowsAbout: [
    "Multi-agent coordination",
    "Decentralized task allocation",
    "LLM-assisted planning",
    "Machine-learning software",
  ],
  affiliation: { "@type": "CollegeOrUniversity", name: profile.institution },
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "Rochester Institute of Technology",
    },
    { "@type": "CollegeOrUniversity", name: "University of Narowal" },
  ],
  sameAs: Object.values(profile.links),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") {
          document.documentElement.dataset.theme = t;
          document
            .querySelector('meta[name="color-scheme"]')
            ?.setAttribute("content", t);
        }
      } catch {}
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/newsreader-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#f4f1de" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL("/og/default.png", Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Khawaja Abaid Ullah — PhD student at RIT KAS Lab; multi-agent coordination and ML software"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL("/og/default.png", Astro.site)}
    />
    <meta
      name="twitter:image:alt"
      content="Khawaja Abaid Ullah — Multi-Agent Coordination & ML Software, RIT KAS Lab"
    />
    {noindex && <meta name="robots" content="noindex" />}
    {Astro.url.pathname === "/" && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(person).replace(/</g, "\\u003c")}
      />
    )}
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main-content" class="container" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <div
      id="site-announcer"
      class="visually-hidden"
      aria-live="polite"
      aria-atomic="true"
    ></div>
    <script>
      const announcer = document.getElementById("site-announcer");
      document.addEventListener("click", async (event) => {
        const target = (event.target as Element | null)?.closest<HTMLElement>(
          "[data-copy]",
        );
        if (!target) return;
        const value = target.dataset.copy;
        if (!value) return;
        const labelEl = target.querySelector<HTMLElement>("[data-copy-label]");
        const original = labelEl?.textContent ?? "";
        const announceText =
          target.dataset.copyAnnounce ?? "Copied to clipboard";
        try {
          await navigator.clipboard.writeText(value);
          if (labelEl) labelEl.textContent = "Copied";
          target.dataset.copied = "true";
          if (announcer) announcer.textContent = announceText;
          window.setTimeout(() => {
            if (labelEl) labelEl.textContent = original;
            delete target.dataset.copied;
          }, 1800);
        } catch {
          if (announcer) announcer.textContent = "Unable to copy automatically";
        }
      });
    </script>
  </body>
</html>
