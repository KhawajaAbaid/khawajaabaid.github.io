---
import type { CollectionEntry } from "astro:content";
import LinkList from "./LinkList.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  idPrefix?: string;
}

const {
  entry: { data, id },
  idPrefix = "",
} = Astro.props;

const primaryHref = data.links[0]?.href;
const categoryLabel =
  data.kind ??
  (data.category === "research-system"
    ? "Research implementation"
    : "ML engineering");
---

<article class="project-entry" id={`${idPrefix}${id}`}>
  <div class="project-head">
    <div class="project-title-group">
      <h3>
        {primaryHref ? (
          <a href={primaryHref} class="project-title-link">
            {data.title}
          </a>
        ) : (
          data.title
        )}
      </h3>
      <span class="project-kind">{categoryLabel}</span>
    </div>

    {data.links.length > 0 && (
      <LinkList links={data.links} context={data.title} />
    )}
  </div>

  <p class="project-summary">{data.summary}</p>

  {data.tags.length > 0 && (
    <ul class="tag-line project-tags" role="list">
      {data.tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  )}
</article>

<style>
  .project-entry {
    min-inline-size: 0;
    padding-block: 1.35rem;
    border-block-start: 1px solid var(--border);
  }

  .project-entry:first-child {
    padding-block-start: 0;
    border-block-start: 0;
  }

  .project-entry:last-child {
    padding-block-end: 0;
  }

  .project-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.25rem;
  }

  .project-title-group {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
  }

  .project-title-link {
    text-decoration: none;
  }

  .project-title-link:hover {
    color: var(--accent);
    text-decoration-line: underline;
    text-underline-offset: 0.2em;
  }

  .project-kind {
    font-family: var(--font-mono);
    font-size: 0.69rem;
    color: var(--text-faint);
  }

  .project-summary {
    margin-block-start: 0.4rem;
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .project-tags {
    margin-block-start: 0.55rem;
  }
</style>
