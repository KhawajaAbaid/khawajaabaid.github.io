---
import {
  experienceLedger,
  educationLedger,
  apparatusSkills,
} from "../data/profile";
---

<div class="career-monograph">
  <div class="career-block">
    <p class="sub-eyebrow">Appointments &amp; Industry</p>
    <ol class="ledger-list" role="list">
      {
        experienceLedger.map((item) => (
          <li class="ledger-row">
            <time class="ledger-period">{item.period}</time>
            <div class="ledger-content">
              <div class="ledger-head">
                <h3>{item.role}</h3>
                {item.note && (
                  <span
                    class:list={["meta-note", item.featured ? "warm" : "teal"]}
                  >
                    {item.note}
                  </span>
                )}
              </div>
              <p class="ledger-org">
                {item.organization} · <span>{item.location}</span>
              </p>
              <ul class="ledger-bullets">
                {item.highlights.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="career-block">
    <p class="sub-eyebrow">Education</p>
    <ol class="ledger-list" role="list">
      {
        educationLedger.map((edu) => (
          <li class="ledger-row">
            <time class="ledger-period">{edu.period}</time>
            <div class="ledger-content">
              <div class="ledger-head">
                <h3>{edu.degree}</h3>
                <span class="meta-note warm">{edu.note}</span>
              </div>
              <p class="ledger-org">
                {edu.institution} · <span>{edu.location}</span>
              </p>
              <p class="ledger-detail">{edu.details}</p>
              {edu.thesisHref && (
                <div class="links ledger-links">
                  <a href={edu.thesisHref}>
                    Master’s Thesis (RIT Repository){" "}
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="career-block">
    <p class="sub-eyebrow">Technical Stack</p>
    <dl class="stack-dl">
      {
        apparatusSkills.map((group) => (
          <div class="stack-row">
            <dt>{group.label}</dt>
            <dd>{group.items.join(" · ")}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>

<style>
  .career-monograph {
    display: grid;
    gap: 2.35rem;
  }

  .career-block + .career-block {
    padding-block-start: 2rem;
    border-block-start: 1px solid var(--border);
  }

  .sub-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.71rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brass);
    margin-block-end: 1.1rem;
  }

  .ledger-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.45rem;
  }

  .ledger-row {
    display: grid;
    grid-template-columns: 9.75rem minmax(0, 1fr);
    gap: 0.35rem 1.5rem;
    align-items: baseline;
  }

  .ledger-period {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-faint);
  }

  .ledger-content {
    min-inline-size: 0;
  }

  .ledger-head {
    display: flex;
    flex-wrap: wrap;
    align-items: safe center;
    gap: 0.35rem 0.75rem;
  }

  .ledger-org {
    margin-block-start: 0.18rem;
    font-size: 0.85rem;
    color: var(--text);
  }

  .ledger-org span {
    color: var(--text-faint);
  }

  .ledger-bullets {
    margin: 0.45rem 0 0;
    padding-inline-start: 1.1rem;
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .ledger-detail {
    margin-block-start: 0.38rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .ledger-links {
    margin-block-start: 0.25rem;
  }

  /* Compact 4-Row Technical Stack */
  .stack-dl {
    display: grid;
    gap: 0.65rem;
  }

  .stack-row {
    display: grid;
    grid-template-columns: 9.75rem minmax(0, 1fr);
    gap: 0.2rem 1.5rem;
    align-items: baseline;
    font-size: 0.9rem;
  }

  .stack-row dt {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-faint);
  }

  .stack-row dd {
    min-inline-size: 0;
    color: var(--text-muted);
  }

  @media (max-width: 42em) {
    .ledger-row,
    .stack-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }
</style>
