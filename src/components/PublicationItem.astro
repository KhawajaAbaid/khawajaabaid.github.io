---
import type { CollectionEntry } from "astro:content";
import { profile } from "../data/profile";
import LinkList from "./LinkList.astro";

interface Props {
  entry: CollectionEntry<"publications">;
  headingLevel?: "h2" | "h3";
}

const {
  entry: { data, id },
  headingLevel: Heading = "h3",
} = Astro.props;

const primaryHref = data.arxiv
  ? `https://arxiv.org/abs/${data.arxiv}`
  : data.pdf;
const metaParts = [
  data.venue,
  data.status,
  String(data.date?.getUTCFullYear() ?? data.year),
]
  .filter(Boolean)
  .filter((v, idx, arr) => arr.indexOf(v) === idx);
---

<article class="publication-entry" id={id}>
  <p class="pub-meta">{metaParts.join(" · ")}</p>

  <Heading class="pub-title">
    {primaryHref ? (
      <a href={primaryHref} class="pub-title-link">
        {data.title}
      </a>
    ) : (
      data.title
    )}
  </Heading>

  <p class="pub-authors">
    {data.authors.map((author, index) => (
      <>
        {index > 0 && ", "}
        {author === profile.name ? <strong>{author}</strong> : author}
      </>
    ))}
  </p>

  <p class="pub-summary">{data.summary}</p>

  <div class="pub-actions">
    {data.links.length > 0 && (
      <LinkList links={data.links} context={data.title} />
    )}

    {data.bibtex && (
      <button
        type="button"
        class="inline-action copy-trigger"
        data-copy={data.bibtex.trim()}
        data-copy-announce={`BibTeX copied for ${data.title}`}
      >
        <span data-copy-label>Copy BibTeX</span>
      </button>
    )}
  </div>

  {data.bibtex && (
    <details class="citation-details">
      <summary>
        <span>BibTeX</span>
        <span class="visually-hidden"> for {data.title}</span>
      </summary>
      <pre tabindex="0"><code>{data.bibtex.trim()}</code></pre>
    </details>
  )}
</article>

<style>
  .publication-entry {
    min-inline-size: 0;
    padding-block: 1.5rem;
    border-block-start: 1px solid var(--border);
  }

  .publication-entry:first-child {
    padding-block-start: 0;
    border-block-start: 0;
  }

  .publication-entry:last-child {
    padding-block-end: 0;
  }

  .pub-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--brass);
    letter-spacing: 0.02em;
  }

  .pub-title {
    margin-block-start: 0.3rem;
    font-size: clamp(1.18rem, 1.08rem + 0.4vw, 1.36rem);
    line-height: 1.3;
    max-inline-size: 62ch;
  }

  .pub-title-link {
    text-decoration: none;
  }

  .pub-title-link:hover {
    color: var(--accent);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .pub-authors {
    margin-block-start: 0.35rem;
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .pub-authors strong {
    font-weight: 600;
    color: var(--text);
    text-decoration-line: underline;
    text-decoration-color: var(--brass-vivid);
    text-underline-offset: 0.22em;
  }

  .pub-summary {
    margin-block-start: 0.55rem;
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .pub-actions {
    margin-block-start: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    align-items: safe center;
    gap: 0.25rem 1.15rem;
  }

  .citation-details {
    margin-block-start: 0.35rem;
  }

  .citation-details pre {
    margin-block-start: 0.45rem;
  }
</style>
