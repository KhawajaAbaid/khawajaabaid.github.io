---
import { directions } from "../data/profile";
import LinkList from "./LinkList.astro";
---

<ol class="directions-list" role="list">
  {
    directions.map((d) => (
      <li id={d.id} class:list={["direction-item", d.accent]}>
        <div class="direction-head">
          <h3>{d.title}</h3>
          <span class="direction-status">{d.status}</span>
        </div>

        <p class="direction-summary">{d.summary}</p>

        <div class="direction-foot">
          <ul class="tag-line" role="list">
            {d.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
          {d.links.length > 0 && (
            <LinkList links={d.links} context={d.title} />
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .directions-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.75rem;
  }

  .direction-item {
    min-inline-size: 0;
    padding-inline-start: 1.15rem;
    border-inline-start: 2px solid var(--border-strong);
  }

  .direction-item.teal {
    border-inline-start-color: var(--teal-vivid);
  }

  .direction-item.peach {
    border-inline-start-color: var(--accent-vivid);
  }

  .direction-item.brass {
    border-inline-start-color: var(--brass-vivid);
  }

  .direction-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .direction-status {
    font-family: var(--font-mono);
    font-size: 0.71rem;
    color: var(--text-faint);
  }

  .direction-summary {
    margin-block-start: 0.45rem;
    font-size: 0.94rem;
    color: var(--text-muted);
  }

  .direction-foot {
    margin-block-start: 0.65rem;
    display: flex;
    flex-wrap: wrap;
    align-items: safe center;
    justify-content: space-between;
    gap: 0.35rem 1.25rem;
  }
</style>
