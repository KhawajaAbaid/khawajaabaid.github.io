---
import { profile, navigation } from "../data/profile";
const path = Astro.url.pathname;
const isHome = path === "/";
const roman = ["I.", "II.", "III.", "IV."];
---

{
  isHome ? (
    <div id="top" class="study-top-anchor" aria-hidden="true" />
  ) : (
    <header class="study-shelf-ledge container" id="top">
      <div class="shelf-ledge-wood">
        <a class="return-study-plaque" href="/">
          <span class="plaque-kicker" aria-hidden="true">
            ← RETURN TO STUDY ROOM
          </span>
          <span class="plaque-owner">{profile.name}</span>
        </a>

        <nav class="shelf-compartments" aria-label="Study Bookcase Shelves">
          {navigation.map((item, idx) => (
            <a
              href={item.href}
              class="shelf-compartment-link"
              aria-current={path.startsWith(item.href) ? "page" : undefined}
            >
              {idx < roman.length && (
                <span class="shelf-roman" aria-hidden="true">
                  {roman[idx]}
                </span>
              )}
              <span>{item.label}</span>
            </a>
          ))}
        </nav>

        <!-- Pure Emeralite Lamp & Beaded Brass Pull-Chain (No Button Box or Text) -->
        <button
          class="lamp-chain-only"
          type="button"
          data-lamp-toggle
          aria-label="Pull Banker's Lamp brass chain to switch room lighting"
          aria-pressed="false"
          title="Pull brass chain to switch room lighting"
        >
          <svg width="38" height="60" viewBox="0 0 38 60" fill="none" aria-hidden="true">
            <path
              d="M4 18 C6.5 7, 31.5 7, 34 18 Z"
              fill="var(--teal)"
              stroke="#241710"
              stroke-width="1.5"
            />
            <line
              x1="3"
              y1="18"
              x2="35"
              y2="18"
              stroke="var(--brass)"
              stroke-width="2.4"
              stroke-linecap="round"
            />
            <g class="pull-chain-cord">
              <line x1="25" y1="18" x2="25" y2="43" stroke="#c49240" stroke-width="1.1" />
              <circle cx="25" cy="22" r="1.7" fill="var(--brass)" stroke="#241710" stroke-width="0.5" />
              <circle cx="25" cy="27" r="1.7" fill="var(--brass)" stroke="#241710" stroke-width="0.5" />
              <circle cx="25" cy="32" r="1.7" fill="var(--brass)" stroke="#241710" stroke-width="0.5" />
              <circle cx="25" cy="37" r="1.7" fill="var(--brass)" stroke="#241710" stroke-width="0.5" />
              <circle cx="25" cy="42" r="1.7" fill="var(--brass)" stroke="#241710" stroke-width="0.5" />
              <path
                d="M21.5 44.5 C21.5 42.2, 28.5 42.2, 28.5 44.5 L27.5 53 C27.2 55.2, 22.8 55.2, 22.5 53 Z"
                fill="var(--brass)"
                stroke="#241710"
                stroke-width="1.1"
              />
            </g>
          </svg>
        </button>
      </div>
    </header>
  )
}

<script>
  const root = document.documentElement;
  const metaScheme = document.querySelector<HTMLMetaElement>(
    'meta[name="color-scheme"]',
  );
  const toggles = document.querySelectorAll<Element>("[data-lamp-toggle]");
  const media = window.matchMedia("(prefers-color-scheme: dark)");

  function getStoredScheme(): "light" | "dark" | null {
    try {
      const val = localStorage.getItem("theme");
      return val === "light" || val === "dark" ? val : null;
    } catch {
      return null;
    }
  }

  function isDarkActive(): boolean {
    const stored = getStoredScheme();
    if (stored) return stored === "dark";
    if (root.dataset.theme === "light" || root.dataset.theme === "dark") {
      return root.dataset.theme === "dark";
    }
    return media.matches;
  }

  function applySchemeState(stored: "light" | "dark" | null) {
    if (stored) {
      root.dataset.theme = stored;
      metaScheme?.setAttribute("content", stored);
    } else {
      delete root.dataset.theme;
      metaScheme?.setAttribute("content", "light dark");
    }
    const dark = isDarkActive();
    toggles.forEach((btn) => {
      btn.setAttribute("aria-pressed", String(dark));
      btn.setAttribute(
        "aria-label",
        dark
          ? "Pull Banker's Lamp brass chain for Golden-Hour Daylight study"
          : "Pull Banker's Lamp brass chain for Nocturnal Lamplight study",
      );
    });
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", dark ? "#181924" : "#f4f1de");
  }

  function toggleTheme(triggerEl?: Element) {
    const currentlyDark = isDarkActive();
    const target: "light" | "dark" = currentlyDark ? "light" : "dark";
    const systemScheme: "light" | "dark" = media.matches ? "dark" : "light";

    /* Per modern-web-guidance `dark-mode-toggle`: check divergence at storage time only */
    const nextStored = target === systemScheme ? null : target;
    try {
      if (nextStored === null) {
        localStorage.removeItem("theme");
      } else {
        localStorage.setItem("theme", nextStored);
      }
    } catch {
      /* Storage blocked; still apply in-memory */
    }

    if (nextStored === null) {
      delete root.dataset.theme;
      metaScheme?.setAttribute("content", "light dark");
    } else {
      root.dataset.theme = nextStored;
      metaScheme?.setAttribute("content", nextStored);
    }

    if (triggerEl) {
      triggerEl.classList.remove("chain-pulled");
      void triggerEl.getBoundingClientRect();
      triggerEl.classList.add("chain-pulled");
    }

    const roomScene = document.querySelector(".study-room-stage");
    if (roomScene) {
      roomScene.classList.remove("lamp-switching");
      void roomScene.getBoundingClientRect();
      roomScene.classList.add("lamp-switching");
    }

    applySchemeState(nextStored);
  }

  applySchemeState(getStoredScheme());

  toggles.forEach((btn) => {
    btn.addEventListener("click", () => toggleTheme(btn));
    btn.addEventListener("keydown", (e) => {
      const evt = e as KeyboardEvent;
      if (evt.key === "Enter" || evt.key === " ") {
        evt.preventDefault();
        toggleTheme(btn);
      }
    });
  });

  media.addEventListener("change", () => {
    applySchemeState(getStoredScheme());
  });

  window.addEventListener("storage", (e) => {
    if (e.key === "theme" || e.key === null) {
      applySchemeState(getStoredScheme());
    }
  });
</script>

<style>
  .study-top-anchor {
    height: 0;
  }

  /* Interior Pages: Carved Mahogany Bookcase Shelf Ledge */
  .study-shelf-ledge {
    padding-top: 1rem;
  }

  .shelf-ledge-wood {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 1.25rem;
    background: linear-gradient(180deg, #3b2518 0%, #26170e 100%);
    border: 2px solid var(--wood-mid);
    border-bottom: 4px solid var(--brass);
    border-radius: 6px;
    box-shadow: var(--card-shadow);
  }

  .return-study-plaque {
    display: flex;
    flex-direction: column;
    gap: 0.08rem;
    padding: 0.35rem 0.75rem;
    background: linear-gradient(135deg, #d4a149 0%, #f5dba3 50%, #c28e38 100%);
    border: 1px solid #1c110a;
    border-radius: 3px;
    text-decoration: none;
    color: #1e140c !important;
    flex-shrink: 0;
  }

  .return-study-plaque:hover {
    filter: brightness(1.06);
  }

  .plaque-kicker {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #4a3020;
  }

  .plaque-owner {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.15;
    color: #1e140c;
  }

  .shelf-compartments {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .shelf-compartment-link {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    padding: 0.42rem 0.78rem;
    background: #352013;
    border: 1px solid rgba(242, 204, 143, 0.55);
    border-left: 3px solid var(--accent);
    border-radius: 3px;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.94rem;
    font-weight: 500;
    color: #faf8ef !important;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease;
  }

  .shelf-compartment-link:hover,
  .shelf-compartment-link[aria-current="page"] {
    background: #4d2f1c;
    border-color: #faf8ef;
    transform: translateY(-2px);
  }

  .shelf-compartment-link[aria-current="page"] {
    border-left-color: var(--brass-light);
    box-shadow: 0 3px 10px rgba(242, 204, 143, 0.25);
  }

  .shelf-roman {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--brass-light);
  }

  /* Pure Lamp & Chain Trigger (No Button Box) */
  .lamp-chain-only {
    background: transparent;
    border: 0;
    padding: 0 0.15rem;
    margin-block: -6px;
    display: grid;
    place-items: center;
    cursor: pointer;
    flex-shrink: 0;
  }

  .pull-chain-cord {
    transition:
      transform 240ms cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 200ms ease;
  }

  .lamp-chain-only:hover .pull-chain-cord,
  .lamp-chain-only:focus-visible .pull-chain-cord {
    transform: translateY(5px);
    filter: drop-shadow(0 3px 8px rgba(242, 204, 143, 0.7));
  }

  .lamp-chain-only.chain-pulled .pull-chain-cord {
    animation: pullChainSpring 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes pullChainSpring {
    0% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(9px);
    }
    100% {
      transform: translateY(0);
    }
  }

  @media (max-width: 860px) {
    .shelf-ledge-wood {
      flex-wrap: wrap;
    }
    .shelf-compartments {
      order: 3;
      flex-basis: 100%;
      padding-top: 0.45rem;
      border-top: 1px solid rgba(242, 204, 143, 0.25);
    }
  }
</style>
