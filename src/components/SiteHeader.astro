---
import { profile, navigation } from "../data/profile";
const path = Astro.url.pathname;
const isHome = path === "/";
---

{
  !isHome && (
    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href="/">
          <span class="wordmark-arrow" aria-hidden="true">←</span>
          <span>Study Room · {profile.name}</span>
          <span class="wordmark-dot" aria-hidden="true">.</span>
        </a>

        <div class="header-right">
          <nav aria-label="Primary">
            {navigation.map((item) => {
              const current = !item.external && path.startsWith(item.href);
              return (
                <a
                  href={item.href}
                  class="nav-link"
                  aria-current={current ? "page" : undefined}
                >
                  {item.label}
                </a>
              );
            })}
          </nav>

          <button
            type="button"
            class="lamp-toggle"
            data-lamp-toggle
            title="Toggle study lighting"
          >
            <span class="visually-hidden label-to-dark">
              Switch to nocturnal lamplight theme
            </span>
            <span class="visually-hidden label-to-light">
              Switch to sunlit daylight theme
            </span>
            <svg
              width="20"
              height="24"
              viewBox="0 0 20 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M3 9.5C4.2 4.6 15.8 4.6 17 9.5H3Z"
                fill="var(--teal-vivid)"
                stroke="currentColor"
                stroke-width="1.25"
                stroke-linejoin="round"
              />
              <line
                x1="2.2"
                y1="9.5"
                x2="17.8"
                y2="9.5"
                stroke="var(--brass-vivid)"
                stroke-width="1.6"
                stroke-linecap="round"
              />
              <line
                x1="10"
                y1="9.5"
                x2="10"
                y2="19.5"
                stroke="currentColor"
                stroke-width="1.2"
              />
              <line
                x1="6"
                y1="19.5"
                x2="14"
                y2="19.5"
                stroke="currentColor"
                stroke-width="1.35"
                stroke-linecap="round"
              />
              <g class="lamp-pull-cord">
                <line
                  x1="14"
                  y1="9.8"
                  x2="14"
                  y2="15.5"
                  stroke="var(--brass-vivid)"
                  stroke-width="1.1"
                />
                <circle cx="14" cy="16.8" r="1.45" fill="var(--brass-vivid)" />
              </g>
            </svg>
          </button>
        </div>
      </div>
    </header>
  )
}

<script>
  const root = document.documentElement;
  const metaScheme = document.querySelector<HTMLMetaElement>(
    'meta[name="color-scheme"]',
  );
  const media = window.matchMedia("(prefers-color-scheme: dark)");

  function getStoredScheme(): "light" | "dark" | null {
    try {
      const val = localStorage.getItem("theme");
      return val === "light" || val === "dark" ? val : null;
    } catch {
      return null;
    }
  }

  function isDarkActive(): boolean {
    const stored = getStoredScheme();
    if (stored) return stored === "dark";
    if (root.dataset.theme === "light" || root.dataset.theme === "dark") {
      return root.dataset.theme === "dark";
    }
    return media.matches;
  }

  function syncThemeDOM(stored: "light" | "dark" | null) {
    if (stored) {
      root.dataset.theme = stored;
      metaScheme?.setAttribute("content", stored);
    } else {
      delete root.dataset.theme;
      metaScheme?.setAttribute("content", "light dark");
    }
    const dark = isDarkActive();
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", dark ? "#181924" : "#f4f1de");

    document
      .querySelectorAll<SVGElement>(".lamp-chain-interactive[data-lamp-toggle]")
      .forEach((chain) => {
        chain.setAttribute(
          "aria-label",
          dark
            ? "Pull Banker's Lamp brass chain to switch to sunlit daylight"
            : "Pull Banker's Lamp brass chain to switch to nocturnal lamplight",
        );
      });
  }

  function toggleTheme(trigger?: Element | null) {
    const currentlyDark = isDarkActive();
    const target: "light" | "dark" = currentlyDark ? "light" : "dark";
    const systemScheme: "light" | "dark" = media.matches ? "dark" : "light";

    /* Check divergence from OS preference ONLY at storage time */
    const nextStored = target === systemScheme ? null : target;
    try {
      if (nextStored === null) {
        localStorage.removeItem("theme");
      } else {
        localStorage.setItem("theme", nextStored);
      }
    } catch {}

    syncThemeDOM(nextStored);

    if (trigger) {
      trigger.classList.remove("cord-pulled");
      void trigger.getBoundingClientRect();
      trigger.classList.add("cord-pulled");
    }

    const roomStage = document.querySelector<HTMLElement>(".study-room-stage");
    if (roomStage) {
      roomStage.classList.remove("lamp-switching");
      void roomStage.getBoundingClientRect();
      roomStage.classList.add("lamp-switching");
    }
  }

  syncThemeDOM(getStoredScheme());

  document.addEventListener("click", (event) => {
    const toggle = (event.target as Element | null)?.closest(
      "[data-lamp-toggle]",
    );
    if (toggle) {
      toggleTheme(toggle);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" && event.key !== " ") return;
    const toggle = (event.target as Element | null)?.closest(
      "[data-lamp-toggle]",
    );
    if (!toggle || toggle.tagName.toLowerCase() === "button") return;
    event.preventDefault();
    toggleTheme(toggle);
  });

  media.addEventListener("change", () => {
    /* Never delete stored value on OS change; re-evaluate effective theme */
    syncThemeDOM(getStoredScheme());
  });

  window.addEventListener("storage", (event) => {
    if (event.key === "theme" || event.key === null) {
      syncThemeDOM(getStoredScheme());
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: safe center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.85rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--heading);
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark:hover {
    color: var(--accent);
  }

  .wordmark-arrow {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--brass);
  }

  .wordmark-dot {
    color: var(--accent-vivid);
    margin-inline-start: -0.25rem;
  }

  .header-right {
    display: flex;
    flex-wrap: wrap;
    align-items: safe center;
    gap: 0.35rem 1.2rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: safe center;
    gap: 0.2rem 1.15rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 2rem;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--heading);
  }

  .nav-link[aria-current="page"] {
    text-decoration-line: underline;
    text-decoration-color: var(--accent-vivid);
    text-underline-offset: 0.35em;
  }

  .lamp-toggle {
    display: inline-grid;
    place-items: center;
    min-inline-size: 2.25rem;
    min-block-size: 2.25rem;
    padding: 0.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--heading);
    transition:
      border-color 150ms ease,
      color 150ms ease;
  }

  .lamp-toggle:hover {
    border-color: var(--border-strong);
    color: var(--accent);
  }

  .lamp-pull-cord {
    transition: transform 200ms ease;
  }

  .lamp-toggle:hover .lamp-pull-cord,
  .lamp-toggle:focus-visible .lamp-pull-cord {
    transform: translateY(1.8px);
  }

  .lamp-toggle.cord-pulled .lamp-pull-cord {
    animation: cordDip 320ms ease;
  }

  @keyframes cordDip {
    0% {
      transform: translateY(0);
    }
    45% {
      transform: translateY(3.5px);
    }
    100% {
      transform: translateY(0);
    }
  }

  /* Dual state labels driven purely by effective scheme */
  .label-to-light {
    display: none;
  }

  :global(:root[data-theme="dark"]) .label-to-dark,
  :global(:root:has(> head > meta[name="color-scheme"][content="dark"]))
    .label-to-dark {
    display: none;
  }

  :global(:root[data-theme="dark"]) .label-to-light,
  :global(:root:has(> head > meta[name="color-scheme"][content="dark"]))
    .label-to-light {
    display: inline;
  }

  @media (prefers-color-scheme: dark) {
    :global(
        :root:not([data-theme="light"]):not(
            :has(> head > meta[name="color-scheme"][content="light"])
          )
      )
      .label-to-dark {
      display: none;
    }
    :global(
        :root:not([data-theme="light"]):not(
            :has(> head > meta[name="color-scheme"][content="light"])
          )
      )
      .label-to-light {
      display: inline;
    }
  }

  @media (pointer: coarse) {
    .nav-link,
    .lamp-toggle {
      min-block-size: 2.75rem;
    }
    .lamp-toggle {
      min-inline-size: 2.75rem;
    }
  }

  @media (max-width: 42em) {
    .header-inner {
      padding-block: 0.65rem;
    }
    .header-right {
      inline-size: 100%;
      justify-content: space-between;
      border-block-start: 1px solid var(--border);
      padding-block-start: 0.45rem;
    }
    nav {
      gap: 0.15rem 0.9rem;
    }
    .nav-link {
      font-size: 0.82rem;
    }
  }
</style>
