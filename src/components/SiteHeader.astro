---
import { profile, navigation } from "../data/profile";
const path = Astro.url.pathname;
---

<header class="site-header container" id="top">
  <a class="site-name" href="/"
    ><span class="full-name">{profile.name}</span><span class="short-name"
      >{profile.shortName}</span
    ></a
  >
  <div class="header-controls">
    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="primary-navigation"
      hidden>Menu <span aria-hidden="true">+</span></button
    >
    <nav id="primary-navigation" aria-label="Primary">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={path.startsWith(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="mobile-email" href={`mailto:${profile.email}`}>Email</a>
    </nav>
    <button
      class="theme-toggle"
      type="button"
      aria-label="Use dark theme"
      aria-pressed="false"
      hidden
    >
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"
        ><circle
          cx="12"
          cy="12"
          r="7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"></circle><path
          d="M12 5a7 7 0 0 1 0 14Z"
          fill="currentColor"></path></svg
      >
    </button>
  </div>
</header>
<script>
  const root = document.documentElement;
  const theme = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const media = window.matchMedia("(prefers-color-scheme: dark)");
  let manual = root.dataset.theme === "light" || root.dataset.theme === "dark";
  function syncTheme() {
    const dark =
      root.dataset.theme === "dark" || (!root.dataset.theme && media.matches);
    theme?.setAttribute("aria-pressed", String(dark));
    theme?.setAttribute(
      "aria-label",
      dark ? "Use light theme" : "Use dark theme",
    );
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", dark ? "#11110f" : "#f7f7f3");
  }
  if (theme) {
    theme.hidden = false;
    syncTheme();
    theme.addEventListener("click", () => {
      const next =
        theme.getAttribute("aria-pressed") === "true" ? "light" : "dark";
      root.dataset.theme = next;
      manual = true;
      try {
        localStorage.setItem("theme", next);
      } catch {
        /* Optional persistence. */
      }
      syncTheme();
    });
  }
  media.addEventListener("change", () => {
    if (!manual) syncTheme();
  });
  const menu = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.querySelector<HTMLElement>("#primary-navigation");
  const narrow = window.matchMedia("(max-width: 720px)");
  function closeMenu(returnFocus = false) {
    menu?.setAttribute("aria-expanded", "false");
    if (nav) nav.hidden = narrow.matches;
    if (returnFocus) menu?.focus();
  }
  function syncMenu() {
    if (menu) menu.hidden = !narrow.matches;
    closeMenu();
  }
  menu?.addEventListener("click", () => {
    const open = menu.getAttribute("aria-expanded") !== "true";
    menu.setAttribute("aria-expanded", String(open));
    if (nav) nav.hidden = !open;
  });
  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      menu?.getAttribute("aria-expanded") === "true"
    )
      closeMenu(true);
  });
  nav?.addEventListener("click", (event) => {
    if ((event.target as Element).closest("a") && narrow.matches) closeMenu();
  });
  narrow.addEventListener("change", syncMenu);
  syncMenu();
</script>
<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    min-height: 102px;
    border-bottom: 1px solid var(--border);
  }
  .site-name {
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .header-controls {
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }
  nav {
    display: flex;
    gap: 1.8rem;
    align-items: center;
  }
  nav a {
    min-height: 44px;
    display: flex;
    align-items: center;
    text-decoration: none;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  nav a[aria-current="page"] {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: 1px solid var(--border);
    border-radius: 50%;
  }
  .short-name,
  nav .mobile-email {
    display: none;
  }
  .menu-toggle {
    background: none;
    border: 0;
    padding: 0 8px;
    min-height: 44px;
    font-size: 0.8rem;
  }
  .menu-toggle span {
    margin-left: 8px;
  }
  .menu-toggle[aria-expanded="true"] span {
    transform: rotate(45deg);
    display: inline-block;
  }
  @media (max-width: 900px) {
    nav {
      gap: 1.1rem;
    }
    .header-controls {
      gap: 1rem;
    }
  }
  @media (max-width: 720px) {
    .site-header {
      min-height: 82px;
      position: relative;
      flex-wrap: wrap;
      gap: 0;
      padding-block: 18px;
    }
    .full-name {
      display: none;
    }
    .short-name {
      display: inline;
    }
    .header-controls {
      gap: 0.6rem;
      display: contents;
    }
    .theme-toggle {
      margin-left: 0.7rem;
      width: 40px;
      height: 40px;
    }
    .menu-toggle {
      margin-left: auto;
    }
    nav .mobile-email {
      display: flex;
    }
    nav {
      order: 4;
      flex-basis: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.2rem 1.5rem;
      padding: 1rem 0 0.2rem;
    }
    nav a {
      font-size: 0.95rem;
    }
  }
</style>
