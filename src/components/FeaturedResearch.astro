---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import LinkList from "./LinkList.astro";
interface Props {
  entry: CollectionEntry<"research">;
  reverse?: boolean;
}
const { entry, reverse = false } = Astro.props;
const { data } = entry;
const plateId = `STUDY PLATE // ${entry.id.toUpperCase()} · ${data.date.getUTCFullYear()}`;
---

<article
  class:list={[
    "framed-study-plate",
    "study-panel",
    { reverse, "no-figure": !data.image },
  ]}
>
  <div class="plate-sconce-bar">
    <span class="plate-id">{plateId}</span>
    <span class="brass-tag teal">
      {data.status} · {data.date.getUTCFullYear()}
    </span>
  </div>

  <div class="featured-grid">
    {
      data.image && (
        <figure class="walnut-picture-frame">
          <a href={`/research/${entry.id}/`} aria-label={`Read ${data.title}`}>
            <div class="museum-matting">
              <Image src={data.image} alt={data.imageAlt!} loading="lazy" />
            </div>
          </a>
          <figcaption class="brass-frame-plaque">
            <span>{entry.id.toUpperCase()} SCHEMATIC</span>
            <span>{data.category}</span>
          </figcaption>
        </figure>
      )
    }

    <div class="feature-copy">
      <p class="eyebrow">{data.category}</p>
      <h3>
        <a href={`/research/${entry.id}/`}>{data.title}</a>
      </h3>
      <p class="summary">{data.summary}</p>
      {
        data.metric && (
          <div class="study-metric-plaque">
            <p class="metric-value">{data.metric.value}</p>
            <div class="metric-meta">
              <p class="metric-label">{data.metric.label}</p>
              {data.metric.context && (
                <p class="metric-context">{data.metric.context}</p>
              )}
            </div>
          </div>
        )
      }
      <LinkList
        links={[
          ...data.links,
          {
            label: `Inspect Full Study: ${data.shortTitle ?? data.title}`,
            href: `/research/${entry.id}/`,
          },
        ]}
        context={data.title}
      />
    </div>
  </div>
</article>

<style>
  .framed-study-plate {
    padding: 1.35rem 2.25rem 2.15rem;
    margin-bottom: 2rem;
  }

  .framed-study-plate:last-child {
    margin-bottom: 0;
  }

  .plate-sconce-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-bottom: 0.95rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .plate-id {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    color: var(--heading);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1.08fr 1fr;
    gap: 2.75rem;
    align-items: center;
  }

  .framed-study-plate.no-figure .featured-grid {
    grid-template-columns: 1fr;
    max-width: 68ch;
  }

  .framed-study-plate.reverse .featured-grid {
    grid-template-columns: 1fr 1.08fr;
  }

  .reverse .walnut-picture-frame {
    order: 2;
  }

  /* Ornate Walnut & Brass Picture Frame */
  .walnut-picture-frame {
    min-width: 0;
    background: linear-gradient(145deg, #4a3020, #2b1b11);
    padding: 0.75rem 0.75rem 0.55rem;
    border: 2px solid var(--brass);
    border-radius: 6px;
    box-shadow: 0 10px 24px -8px rgba(24, 15, 10, 0.35);
  }

  .museum-matting {
    background: #faf8ef;
    padding: 0.5rem;
    border: 1px solid #c49240;
    border-radius: 3px;
  }

  .museum-matting img {
    width: 100%;
    border-radius: 2px;
  }

  .walnut-picture-frame a {
    display: block;
  }

  .brass-frame-plaque {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    color: #f2cc8f;
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
    padding-inline: 0.35rem;
    text-transform: uppercase;
  }

  .feature-copy .eyebrow {
    margin-bottom: 0.45rem;
  }

  h3 {
    font-size: clamp(1.75rem, 2.5vw, 2.3rem);
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent-strong);
  }

  .summary {
    font-size: 0.94rem;
    color: var(--text-muted);
    margin-top: 0.85rem;
  }

  .study-metric-plaque {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.15rem;
    margin-block: 1.25rem 0.95rem;
    padding: 0.8rem 1.15rem;
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-left: 4px solid var(--brass);
    border-radius: 4px;
  }

  .metric-value {
    font-family: var(--font-display);
    font-size: 2.75rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--heading);
  }

  .metric-meta {
    flex: 1;
    min-width: 180px;
  }

  .metric-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--heading);
    margin: 0;
  }

  .metric-context {
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-top: 0.18rem;
  }

  .feature-copy :global(.links) {
    margin-top: 0.75rem;
    gap: 0.25rem 1.2rem;
  }

  @media (max-width: 900px) {
    .framed-study-plate {
      padding: 1.15rem 1.5rem 1.75rem;
    }
    .featured-grid {
      gap: 1.75rem;
    }
  }

  @media (max-width: 760px) {
    .featured-grid,
    .framed-study-plate.reverse .featured-grid {
      grid-template-columns: 1fr;
      gap: 1.35rem;
    }
    .reverse .walnut-picture-frame {
      order: 0;
    }
    .metric-value {
      font-size: 2.35rem;
    }
  }
</style>
