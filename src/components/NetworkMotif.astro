<style>
  .study-room-stage {
    position: relative;
    width: 100%;
    border-radius: 8px 8px 0 0;
    overflow: hidden;
    border: 2px solid var(--wood-mid);
    border-bottom: 0;
    background: var(--room-wall-top);
    box-shadow:
      0 18px 44px -12px rgba(24, 15, 10, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
    isolation: isolate;
  }

  .study-room-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Wall & Floor Dynamic Lighting Surfaces */
  .room-wall-bg {
    fill: var(--room-wall-top);
    transition: fill 480ms ease;
  }

  .room-floor-bg {
    fill: var(--room-floor-1);
    transition: fill 480ms ease;
  }

  /* Window Sky Day/Night Transition */
  .window-sky-fill {
    fill: #d8e8e4;
    transition: fill 480ms ease;
  }

  :root[data-theme="dark"] .window-sky-fill,
  :root:has(> head > meta[name="color-scheme"][content="dark"])
    .window-sky-fill {
    fill: #131629;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]):not(
        :has(> head > meta[name="color-scheme"][content="light"])
      )
      .window-sky-fill {
      fill: #131629;
    }
  }

  .daylight-window-scene,
  .daylight-volumetric-rays,
  .daylight-dust-motes {
    opacity: var(--sunbeam-opacity);
    transition: opacity 480ms ease;
    pointer-events: none;
  }

  .nocturnal-window-scene {
    opacity: calc(1 - var(--sunbeam-opacity));
    transition: opacity 480ms ease;
    pointer-events: none;
  }

  .nocturnal-lamp-cone {
    opacity: var(--lamp-cone-opacity);
    transition: opacity 480ms ease;
    pointer-events: none;
  }

  /* Picture Sconce Cones Over the 3 Framed Portraits */
  .portrait-light-cone {
    opacity: calc(0.22 + 0.65 * var(--lamp-cone-opacity));
    transition: opacity 320ms ease;
    pointer-events: none;
  }

  /* Interactive Framed Wall Portraits & Desk Nameplate Hotspots */
  .wall-portrait-group,
  .desk-nameplate-group {
    cursor: pointer;
    transition:
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 280ms ease;
  }

  .wall-portrait-group:hover,
  .wall-portrait-group:focus-visible,
  .wall-portrait-group.active-hotspot {
    transform: translateY(-4px);
    filter: drop-shadow(0 8px 18px rgba(242, 204, 143, 0.42));
    outline: none;
  }

  .wall-portrait-group:hover .portrait-light-cone,
  .wall-portrait-group.active-hotspot .portrait-light-cone {
    opacity: 1;
  }

  .desk-nameplate-group:hover,
  .desk-nameplate-group:focus-visible,
  .desk-nameplate-group.active-hotspot {
    transform: translateY(-3px);
    filter: drop-shadow(0 6px 16px rgba(242, 204, 143, 0.5));
    outline: none;
  }

  /* Floating Dust Motes Animation in Sunbeams */
  .mote {
    animation: driftMote 9s ease-in-out infinite alternate;
  }
  .m2 {
    animation-duration: 11s;
    animation-delay: -2s;
  }
  .m3 {
    animation-duration: 8s;
    animation-delay: -4s;
  }
  .m4 {
    animation-duration: 12s;
    animation-delay: -1s;
  }
  .m5 {
    animation-duration: 10s;
    animation-delay: -5s;
  }
  .m6 {
    animation-duration: 9.5s;
    animation-delay: -3s;
  }
  .m7 {
    animation-duration: 11.5s;
    animation-delay: -6s;
  }

  @keyframes driftMote {
    0% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(8px, -10px);
