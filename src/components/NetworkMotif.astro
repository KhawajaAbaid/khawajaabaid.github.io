<svg viewBox="0 0 640 460" fill="none" aria-hidden="true" class="network">
  <g stroke="var(--border-strong)" stroke-width=".8" opacity=".6"
    >{edges.map(([a, b]) => <path d={`M${points[a]} L${points[b]}`} />)}</g
  >
  <path
    class="accent-path"
    d="M35 165 157 155 233 246 369 228 408 132 480 58 590 85"
    stroke="var(--accent)"
    stroke-width="1.7"></path>
  {
    points.map(([cx, cy], i) => (
      <circle
        cx={cx}
        cy={cy}
        r={[0, 3, 6, 10, 11, 13, 17].includes(i) ? 4 : 2.7}
        fill={
          [0, 3, 6, 10, 11, 13, 17].includes(i) ? "var(--accent)" : "var(--bg)"
        }
        stroke={
          [0, 3, 6, 10, 11, 13, 17].includes(i)
            ? "var(--accent)"
            : "var(--border-strong)"
        }
        stroke-width="1"
      />
    ))
  }
</svg>
<style>
  .network {
    display: block;
    width: 100%;
  }
  .accent-path {
    animation: breathe 12s ease-in-out infinite;
  }
  @keyframes breathe {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }
</style>
