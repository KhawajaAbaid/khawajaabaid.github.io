---
/* Animated Old-School Classic Study Room Panorama:
   - Tall Arched Window (Golden-Hour Sunbeams & Dust Motes vs. Starry Night & Crescent Moon)
   - Paneled Wainscoting Wall with Built-in Mahogany Bookshelf & Brass Globe
   - Three Interactive Framed Wall Portraits with Brass Picture Sconces (Fulbright, AWS, KAS Lab)
   - Tufted Leather Wingback Study Chair & Carved Walnut Executive Study Desk
   - Interactive Emeralite Green-Glass Banker's Lamp with Pull-Chain (Light / Dark Mode)
   - Engraved Walnut & Brushed Brass Desk Nameplate ("KHAWAJA ABAID ULLAH")
   - Hardwood Plank Floor & Traditional Hand-Knotted Pakistani Qaleen (Lahore Bokhara & Mughal Jaldar Carpet)
*/
---

<div class="study-room-stage" data-study-scene>
  <svg
    viewBox="0 0 1200 600"
    fill="none"
    role="img"
    aria-label="Interactive animated old-school study room of Khawaja Abaid Ullah featuring a walnut desk with an engraved brass nameplate, an Emeralite banker's lamp that switches between daylight and lamplight, a tufted leather chair, wooden floors with a traditional hand-knotted Pakistani Bokhara Qaleen carpet, a wall bookshelf, and framed portraits for U.S. Fulbright Scholar, Amazon Web Services AI/ML, and RIT KAS Lab."
    class="study-room-svg"
  >
    <defs>
      <!-- Rich Walnut & Mahogany Wood Gradients -->
      <linearGradient id="walnutDark" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#4e3322" />
        <stop offset="50%" stop-color="#3b2518" />
        <stop offset="100%" stop-color="#26170e" />
      </linearGradient>

      <linearGradient id="walnutSurface" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#5c3c28" />
        <stop offset="35%" stop-color="#7c5338" />
        <stop offset="65%" stop-color="#6e4830" />
        <stop offset="100%" stop-color="#4d3220" />
      </linearGradient>

      <linearGradient id="mahoganyPanel" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#63412c" />
        <stop offset="100%" stop-color="#3d2618" />
      </linearGradient>

      <!-- Polished & Aged Brass Hardware Gradient -->
      <linearGradient id="brassGold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#b8842f" />
        <stop offset="35%" stop-color="#f7dca4" />
        <stop offset="55%" stop-color="#d9a648" />
        <stop offset="80%" stop-color="#f2cc8f" />
        <stop offset="100%" stop-color="#8f631c" />
      </linearGradient>

      <linearGradient id="brassPlaqueFace" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#d4a149" />
        <stop offset="25%" stop-color="#f5dba3" />
        <stop offset="50%" stop-color="#e3b660" />
        <stop offset="75%" stop-color="#f7e2b5" />
        <stop offset="100%" stop-color="#c28e38" />
      </linearGradient>

      <!-- Emeralite Cased Green Glass Shade -->
      <linearGradient id="emeraliteShade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#a8d5be" />
        <stop offset="48%" stop-color="#81b29a" />
        <stop offset="100%" stop-color="#3f6e57" />
      </linearGradient>

      <!-- Tufted Leather Study Chair Gradient -->
      <linearGradient id="tuftedLeather" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#7c3629" />
        <stop offset="55%" stop-color="#57231a" />
        <stop offset="100%" stop-color="#38150f" />
      </linearGradient>

      <!-- Daylight Volumetric Cathedral Sunbeams -->
      <linearGradient id="windowSunbeam" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#f7e1b5" stop-opacity="0.52" />
        <stop offset="45%" stop-color="#f2cc8f" stop-opacity="0.24" />
        <stop offset="100%" stop-color="#f2cc8f" stop-opacity="0" />
      </linearGradient>

      <!-- Nocturnal Banker's Lamp Volumetric Light Cone -->
      <radialGradient id="deskLampGlow" cx="38%" cy="22%" r="68%">
        <stop offset="0%" stop-color="#fae3b4" stop-opacity="0.88" />
        <stop offset="32%" stop-color="#f2cc8f" stop-opacity="0.45" />
        <stop offset="68%" stop-color="#e07a5f" stop-opacity="0.14" />
        <stop offset="100%" stop-color="#181924" stop-opacity="0" />
      </radialGradient>

      <!-- Brass Picture Sconce Warm Wash -->
      <radialGradient id="sconceGlow" cx="50%" cy="10%" r="80%">
        <stop offset="0%" stop-color="#f7dfa8" stop-opacity="0.78" />
        <stop offset="48%" stop-color="#f2cc8f" stop-opacity="0.28" />
        <stop offset="100%" stop-color="#f2cc8f" stop-opacity="0" />
      </radialGradient>

      <!-- Room Vignette for Cozy Study Depth -->
      <radialGradient id="roomVignette" cx="50%" cy="48%" r="65%">
        <stop offset="60%" stop-color="#000000" stop-opacity="0" />
        <stop offset="100%" stop-color="#0d0907" stop-opacity="0.42" />
      </radialGradient>

      <!-- Traditional Pakistani Madder-Dyed Wool Qaleen Field (Natural Abrash Gradient) -->
      <linearGradient id="pakistaniQaleenField" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#8b2b18" />
        <stop offset="28%" stop-color="#b54128" />
        <stop offset="52%" stop-color="#9c331d" />
        <stop offset="78%" stop-color="#c44d33" />
        <stop offset="100%" stop-color="#842715" />
      </linearGradient>

      <!-- Iconic Pakistani Mori Bokhara Octagonal "Elephant's Foot" Gul (Foreshortened in Perspective) -->
      <g id="pakistaniBokharaGul">
        <!-- Outer Stepped Octagonal Gul Halo -->
        <polygon
          points="-26,-4 -15,-11 15,-11 26,-4 26,4 15,11 -15,11 -26,4"
          fill="#232536"
          stroke="#f2cc8f"
          stroke-width="1.1"
        />
        <!-- Four Alternating Bokhara Quadrants (Warm Ivory #faf8ef & Terracotta Peach #e07a5f) -->
        <!-- Top-Left Quadrant (Ivory) -->
        <polygon points="-23,-3.2 -13.5,-9.5 0,-9.5 0,0 -23,0" fill="#faf8ef" />
        <!-- Bottom-Right Quadrant (Ivory) -->
        <polygon points="23,3.2 13.5,9.5 0,9.5 0,0 23,0" fill="#faf8ef" />
        <!-- Top-Right Quadrant (Burnt Peach / Crimson) -->
        <polygon points="23,-3.2 13.5,-9.5 0,-9.5 0,0 23,0" fill="#e07a5f" />
        <!-- Bottom-Left Quadrant (Burnt Peach / Crimson) -->
        <polygon points="-23,3.2 -13.5,9.5 0,9.5 0,0 -23,0" fill="#e07a5f" />

        <!-- Traditional Filpai (Elephant's Foot Trefoil Clovers) Inside Each Quadrant -->
        <circle cx="-11" cy="-4.8" r="2.1" fill="#9c331d" stroke="#232536" stroke-width="0.6" />
        <circle cx="11" cy="4.8" r="2.1" fill="#9c331d" stroke="#232536" stroke-width="0.6" />
        <circle cx="11" cy="-4.8" r="2.1" fill="#faf8ef" stroke="#232536" stroke-width="0.6" />
        <circle cx="-11" cy="4.8" r="2.1" fill="#faf8ef" stroke="#232536" stroke-width="0.6" />

        <!-- Axial Quadrant Divider Cross -->
        <line x1="-25" y1="0" x2="25" y2="0" stroke="#232536" stroke-width="1" />
        <line x1="0" y1="-10.5" x2="0" y2="10.5" stroke="#232536" stroke-width="1" />

        <!-- Inner Octagonal Star Sanctuary (Muted Teal #81b29a & Brass Gold #f2cc8f) -->
        <polygon
          points="-10,-3 -5.5,-6 5.5,-6 10,-3 10,3 5.5,6 -5.5,6 -10,3"
          fill="#232536"
          stroke="#f2cc8f"
          stroke-width="0.9"
        />
        <polygon
          points="-7,-2 -3.5,-4.2 3.5,-4.2 7,-2 7,2 3.5,4.2 -3.5,4.2 -7,2"
          fill="#81b29a"
        />
        <polygon points="0,-3.2 4.5,0 0,3.2 -4.5,0" fill="#f2cc8f" />
        <circle cx="0" cy="0" r="1.3" fill="#9c331d" />
      </g>

      <!-- Secondary Pakistani Jaldar / Chuval Cruciform Diamond Star (Woven Between Guls) -->
      <g id="pakistaniChuvalStar">
        <polygon
          points="0,-7.5 16,0 0,7.5 -16,0"
          fill="#232536"
          stroke="#f2cc8f"
          stroke-width="0.95"
        />
        <polygon points="0,-5.2 11,0 0,5.2 -11,0" fill="#81b29a" />
        <polygon points="0,-3 6.2,0 0,3 -6.2,0" fill="#faf8ef" />
        <circle cx="0" cy="0" r="1.4" fill="#e07a5f" />
        <!-- Four Cruciform Latch-Hook Tips -->
        <circle cx="0" cy="-8.8" r="1.1" fill="#f2cc8f" />
        <circle cx="0" cy="8.8" r="1.1" fill="#f2cc8f" />
        <circle cx="-18" cy="0" r="1.2" fill="#f2cc8f" />
        <circle cx="18" cy="0" r="1.2" fill="#f2cc8f" />
      </g>

      <!-- Lahori Mughal Border Rosette (Gul-e-Ashrafi) for the Broad Bara Hashiya Border -->
      <g id="lahoriBorderRosette">
        <polygon
          points="0,-4.8 4.8,-3.2 9.5,0 4.8,3.2 0,4.8 -4.8,3.2 -9.5,0 -4.8,-3.2"
          fill="#e07a5f"
          stroke="#f2cc8f"
          stroke-width="0.8"
        />
        <polygon points="0,-2.8 5.2,0 0,2.8 -5.2,0" fill="#faf8ef" />
        <circle cx="0" cy="0" r="1.3" fill="#81b29a" />
        <!-- Flanking Serrated Vine Leaves -->
        <polygon points="-14,-1.8 -10.5,0 -14,1.8 -17.5,0" fill="#81b29a" />
        <polygon points="14,-1.8 17.5,0 14,1.8 10.5,0" fill="#81b29a" />
      </g>
    </defs>

    <!-- ==================== 1. STUDY ROOM BACK WALL & WAINSCOTING ==================== -->
    <rect
      x="0"
      y="0"
      width="1200"
      height="408"
      class="room-wall-bg"
    />

    <!-- Subtle Heritage Boiserie Wall Molding Panels -->
    <g class="wall-boiserie" opacity="0.32">
      <rect x="30" y="24" width="235" height="250" rx="2" stroke="var(--border-strong)" stroke-width="1.5" />
      <rect x="285" y="24" width="260" height="250" rx="2" stroke="var(--border-strong)" stroke-width="1.5" />
      <rect x="565" y="24" width="605" height="250" rx="2" stroke="var(--border-strong)" stroke-width="1.5" />
    </g>

    <!-- Upper Crown Molding Cornice -->
    <rect x="0" y="0" width="1200" height="14" fill="url(#walnutDark)" />
    <line x1="0" y1="14" x2="1200" y2="14" stroke="#c49240" stroke-width="1.2" opacity="0.55" />

    <!-- Lower Carved Walnut Wainscoting (y: 286 -> 408) -->
    <rect x="0" y="286" width="1200" height="122" fill="var(--room-wainscot)" />
    <rect x="0" y="282" width="1200" height="7" fill="url(#walnutSurface)" stroke="#241710" stroke-width="1" />
    <!-- Recessed Wainscot Wood Panels -->
    <g fill="var(--room-wainscot-panel)" stroke="#63412c" stroke-width="1.2">
      <rect x="28" y="302" width="130" height="84" rx="2" />
      <rect x="178" y="302" width="130" height="84" rx="2" />
      <rect x="328" y="302" width="130" height="84" rx="2" />
      <rect x="478" y="302" width="130" height="84" rx="2" />
      <rect x="628" y="302" width="130" height="84" rx="2" />
      <rect x="778" y="302" width="130" height="84" rx="2" />
      <rect x="928" y="302" width="130" height="84" rx="2" />
      <rect x="1078" y="302" width="94" height="84" rx="2" />
    </g>
    <!-- Baseboard Molding -->
    <rect x="0" y="396" width="1200" height="14" fill="#241710" />

    <!-- ==================== 2. WOODEN FLOORS & TRADITIONAL PAKISTANI QALEEN CARPET ==================== -->
    <!-- Hardwood Floor Background -->
    <rect x="0" y="408" width="1200" height="192" class="room-floor-bg" />

    <!-- Perspective Wooden Floor Planks & Grain Lines -->
    <g stroke="#241710" stroke-width="1.2" opacity="0.45">
      <line x1="0" y1="432" x2="1200" y2="432" />
      <line x1="0" y1="460" x2="1200" y2="460" />
      <line x1="0" y1="494" x2="1200" y2="494" />
      <line x1="0" y1="536" x2="1200" y2="536" />
      <line x1="0" y1="584" x2="1200" y2="584" />
      <!-- Perspective Plank Joints -->
      <line x1="180" y1="408" x2="60" y2="600" />
      <line x1="360" y1="408" x2="270" y2="600" />
      <line x1="540" y1="408" x2="500" y2="600" />
      <line x1="680" y1="408" x2="720" y2="600" />
      <line x1="860" y1="408" x2="950" y2="600" />
      <line x1="1040" y1="408" x2="1160" y2="600" />
    </g>

    <!-- TRADITIONAL HAND-KNOTTED PAKISTANI QALEEN (LAHORE MORI BOKHARA & MUGHAL JALDAR CARPET) -->
    <g class="artistic-study-carpet pakistani-qaleen-carpet">
      <!-- Heavy Wool Pile Drop Shadow on Hardwood Floor -->
      <polygon
        points="146,454 1054,454 1140,594 60,594"
        fill="#110905"
        opacity="0.55"
      />

      <!-- Hand-Combed Silk/Cotton Warp Fringes (Jhalar) & Flat-Weave Selvedge Ends (Left & Right) -->
      <g stroke="#f4f1de" stroke-width="1.8" stroke-linecap="round" opacity="0.88">
        <!-- Left Warp Fringe Tassels -->
        <path
          d="M145,454 L129,454 M140,462 L123,462 M135,470 L118,470 M130,478 L112,478 M125,486 L106,486 M120,494 L100,494 M115,502 L94,502 M110,510 L88,510 M104,518 L82,518 M99,526 L76,526 M94,534 L70,534 M88,542 L64,542 M83,550 L58,550 M78,558 L52,558 M73,566 L46,566 M68,574 L40,574 M63,582 L35,582 M59,588 L30,588"
        />
        <!-- Right Warp Fringe Tassels -->
        <path
          d="M1055,454 L1071,454 M1060,462 L1077,462 M1065,470 L1082,470 M1070,478 L1088,478 M1075,486 L1094,486 M1080,494 L1100,494 M1085,502 L1106,502 M1090,510 L1112,510 M1096,518 L1118,518 M1101,526 L1124,526 M1106,534 L1130,534 M1112,542 L1136,542 M1117,550 L1142,550 M1122,558 L1148,558 M1127,566 L1154,566 M1132,574 L1160,574 M1137,582 L1165,582 M1141,588 L1170,588"
        />
      </g>
      <!-- Secondary Gold-Dyed Warp Threads in Fringe -->
      <g stroke="#f2cc8f" stroke-width="1.2" stroke-linecap="round" opacity="0.7">
        <path d="M142,458 L125,458 M132,474 L114,474 M122,490 L103,490 M112,506 L91,506 M101,522 L79,522 M91,538 L67,538 M80,554 L55,554 M70,570 L43,570 M61,585 L32,585" />
        <path d="M1058,458 L1075,458 M1068,474 L1086,474 M1078,490 L1097,490 M1088,506 L1109,506 M1099,522 L1121,522 M1109,538 L1133,538 M1120,554 L1145,554 M1130,570 L1157,570 M1139,585 L1168,585" />
      </g>

      <!-- 1. OUTER SELVEDGE CORD (LAB-E-QALEEN) & KILIM PATTY -->
      <polygon
        points="146,450 1054,450 1138,590 62,590"
        fill="#6e2113"
        stroke="#f2cc8f"
        stroke-width="2.2"
      />

      <!-- 2. OUTER MINOR GUARD BORDER (CHOTA HASHIYA — LAHORI KANGURA CREME & INDIGO BAND) -->
      <polygon
        points="154,454 1046,454 1126,585 74,585"
        fill="#faf8ef"
        stroke="#232536"
        stroke-width="1.4"
      />
      <!-- Reciprocal Kangura Pearl Dots Along Outer Guard -->
      <polygon
        points="159,456.5 1041,456.5 1119,582 81,582"
        fill="none"
        stroke="#b8432a"
        stroke-width="1.6"
        stroke-dasharray="5 5"
      />

      <!-- 3. MAIN BROAD LAHORI BORDER (BARA HASHIYA — TWILIGHT INDIGO VINE & GUL-E-ASHRAFI ROSETTES) -->
      <polygon
        points="164,459 1036,459 1112,579 88,579"
        fill="#232536"
        stroke="#f2cc8f"
        stroke-width="1.6"
      />
      <!-- Meandering Gold Mughal Floral Vine Tendril Through Main Border -->
      <polygon
        points="180,466 1020,466 1090,570 110,570"
        fill="none"
        stroke="#f2cc8f"
        stroke-width="0.9"
        stroke-dasharray="8 4"
        opacity="0.7"
      />

      <!-- Repeating Gul-e-Ashrafi Floral Rosettes Along Foreground Main Border (y = 570, Fully Visible) -->
      <g transform="translate(0, 570)">
        <use href="#lahoriBorderRosette" x="130" />
        <use href="#lahoriBorderRosette" x="198" />
        <use href="#lahoriBorderRosette" x="266" />
        <use href="#lahoriBorderRosette" x="334" />
        <use href="#lahoriBorderRosette" x="402" />
        <use href="#lahoriBorderRosette" x="470" />
        <use href="#lahoriBorderRosette" x="536" />
        <use href="#lahoriBorderRosette" x="600" />
        <use href="#lahoriBorderRosette" x="664" />
        <use href="#lahoriBorderRosette" x="730" />
        <use href="#lahoriBorderRosette" x="798" />
        <use href="#lahoriBorderRosette" x="866" />
        <use href="#lahoriBorderRosette" x="934" />
        <use href="#lahoriBorderRosette" x="1002" />
        <use href="#lahoriBorderRosette" x="1070" />
      </g>
      <!-- Repeating Border Rosettes Along Left & Right Perspective Borders -->
      <g>
        <!-- Left Border Rosettes -->
        <use href="#lahoriBorderRosette" transform="translate(174, 476) scale(0.68)" />
        <use href="#lahoriBorderRosette" transform="translate(160, 498) scale(0.74)" />
        <use href="#lahoriBorderRosette" transform="translate(145, 521) scale(0.80)" />
        <use href="#lahoriBorderRosette" transform="translate(129, 545) scale(0.86)" />
        <!-- Right Border Rosettes -->
        <use href="#lahoriBorderRosette" transform="translate(1026, 476) scale(0.68)" />
        <use href="#lahoriBorderRosette" transform="translate(1040, 498) scale(0.74)" />
        <use href="#lahoriBorderRosette" transform="translate(1055, 521) scale(0.80)" />
        <use href="#lahoriBorderRosette" transform="translate(1071, 545) scale(0.86)" />
        <!-- Back Border Rosettes (Center Kneehole & Wings) -->
        <use href="#lahoriBorderRosette" transform="translate(215, 465) scale(0.65)" />
        <use href="#lahoriBorderRosette" transform="translate(490, 465) scale(0.65)" />
        <use href="#lahoriBorderRosette" transform="translate(545, 465) scale(0.65)" />
        <use href="#lahoriBorderRosette" transform="translate(600, 465) scale(0.65)" />
        <use href="#lahoriBorderRosette" transform="translate(655, 465) scale(0.65)" />
        <use href="#lahoriBorderRosette" transform="translate(710, 465) scale(0.65)" />
        <use href="#lahoriBorderRosette" transform="translate(985, 465) scale(0.65)" />
      </g>

      <!-- 4. INNER ZANJEERA GUARD STRIPE (MUTED TEAL & GOLD CHAIN) -->
      <polygon
        points="190,470 1010,470 1074,562 126,562"
        fill="#81b29a"
        stroke="#232536"
        stroke-width="1.3"
      />

      <!-- 5. CENTRAL MADDER CRIMSON & TERRACOTTA FIELD (MAIDAN) -->
      <polygon
        points="198,474 1002,474 1064,558 136,558"
        fill="url(#pakistaniQaleenField)"
        stroke="#f2cc8f"
        stroke-width="1.5"
      />

      <!-- Subtle Hand-Spun Wool Abrash Striations Across the Field -->
      <g stroke="#732010" stroke-width="1.1" opacity="0.38">
        <line x1="192" y1="484" x2="1008" y2="484" />
        <line x1="182" y1="498" x2="1018" y2="498" />
        <line x1="170" y1="514" x2="1030" y2="514" />
        <line x1="158" y1="531" x2="1042" y2="531" />
        <line x1="146" y1="547" x2="1054" y2="547" />
      </g>

      <!-- 6. STEPPED MUGHAL CORNER SPANDRELS (LACHAK / GOSHA) -->
      <!-- Top-Left & Bottom-Left Corner Spandrels -->
      <polygon
        points="198,474 264,474 242,492 214,502 182,502"
        fill="#232536"
        stroke="#f2cc8f"
        stroke-width="1.1"
      />
      <polygon
        points="136,558 214,558 198,538 174,528 154,528"
        fill="#232536"
        stroke="#f2cc8f"
