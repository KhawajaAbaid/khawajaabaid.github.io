        fill="#232536"
        stroke="#f2cc8f"
        stroke-width="1.1"
      />

      <!-- 7. JALDAR TRELLIS LATTICE LINES CONNECTING THE BOKHARA GULS -->
      <g stroke="#232536" stroke-width="1.1" opacity="0.65">
        <!-- Horizontal Perspective Lattice Rows -->
        <line x1="190" y1="487" x2="1010" y2="487" />
        <line x1="172" y1="515" x2="1028" y2="515" />
        <line x1="150" y1="545" x2="1050" y2="545" />
        <!-- Perspective Longitudinal Lattice Lines -->
        <line x1="238" y1="474" x2="192" y2="558" />
        <line x1="342" y1="474" x2="310" y2="558" />
        <line x1="478" y1="474" x2="432" y2="558" />
        <line x1="548" y1="474" x2="540" y2="558" />
        <line x1="652" y1="474" x2="660" y2="558" />
        <line x1="722" y1="474" x2="768" y2="558" />
        <line x1="858" y1="474" x2="890" y2="558" />
        <line x1="962" y1="474" x2="1008" y2="558" />
      </g>

      <!-- 8. CENTRAL LAHORI SHAHI MEDALLION (TURUNJ) IN DESK KNEEHOLE (x=600, y=514) -->
      <g class="lahori-central-turunj">
        <!-- Left & Right Kalga Palmette Finial Pendants -->
        <polygon
          points="482,514 504,507 518,514 504,521"
          fill="#f2cc8f"
          stroke="#232536"
          stroke-width="1.1"
        />
        <polygon
          points="718,514 696,507 682,514 696,521"
          fill="#f2cc8f"
          stroke="#232536"
          stroke-width="1.1"
        />
