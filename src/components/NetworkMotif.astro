---
/* Animated Old-School Classic Study Room Panorama:
   - Tall Arched Window (Golden-Hour Sunbeams & Dust Motes vs. Starry Night & Crescent Moon)
   - Paneled Wainscoting Wall with Built-in Mahogany Bookshelf & Brass Globe
   - Three Interactive Framed Wall Portraits with Brass Picture Sconces (Fulbright, AWS, KAS Lab)
   - Tufted Leather Wingback Study Chair & Carved Walnut Executive Study Desk
   - Interactive Emeralite Green-Glass Banker's Lamp with Pull-Chain (Light / Dark Mode)
   - Engraved Walnut & Brushed Brass Desk Nameplate ("KHAWAJA ABAID ULLAH")
   - Hardwood Plank Floor & Artistic Woven Persian/Kilim Carpet
*/
---

<div class="study-room-stage" data-study-scene>
  <svg
    viewBox="0 0 1200 600"
    fill="none"
    role="img"
    aria-label="Interactive animated old-school study room of Khawaja Abaid Ullah featuring a walnut desk with an engraved brass nameplate, an Emeralite banker's lamp that switches between daylight and lamplight, a tufted leather chair, wooden floors with an artistic Persian carpet, a wall bookshelf, and framed portraits for U.S. Fulbright Scholar, Amazon Web Services AI/ML, and RIT KAS Lab."
    class="study-room-svg"
  >
    <defs>
      <!-- Rich Walnut & Mahogany Wood Gradients -->
      <linearGradient id="walnutDark" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#4e3322" />
        <stop offset="50%" stop-color="#3b2518" />
        <stop offset="100%" stop-color="#26170e" />
      </linearGradient>

      <linearGradient id="walnutSurface" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#5c3c28" />
        <stop offset="35%" stop-color="#7c5338" />
        <stop offset="65%" stop-color="#6e4830" />
        <stop offset="100%" stop-color="#4d3220" />
      </linearGradient>

      <linearGradient id="mahoganyPanel" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#63412c" />
        <stop offset="100%" stop-color="#3d2618" />
      </linearGradient>

      <!-- Polished & Aged Brass Hardware Gradient -->
      <linearGradient id="brassGold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#b8842f" />
        <stop offset="35%" stop-color="#f7dca4" />
        <stop offset="55%" stop-color="#d9a648" />
        <stop offset="80%" stop-color="#f2cc8f" />
        <stop offset="100%" stop-color="#8f631c" />
      </linearGradient>

      <linearGradient id="brassPlaqueFace" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#d4a149" />
        <stop offset="25%" stop-color="#f5dba3" />
        <stop offset="50%" stop-color="#e3b660" />
        <stop offset="75%" stop-color="#f7e2b5" />
        <stop offset="100%" stop-color="#c28e38" />
      </linearGradient>

      <!-- Emeralite Cased Green Glass Shade -->
      <linearGradient id="emeraliteShade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#a8d5be" />
        <stop offset="48%" stop-color="#81b29a" />
        <stop offset="100%" stop-color="#3f6e57" />
      </linearGradient>

      <!-- Tufted Leather Study Chair Gradient -->
      <linearGradient id="tuftedLeather" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#7c3629" />
        <stop offset="55%" stop-color="#57231a" />
        <stop offset="100%" stop-color="#38150f" />
      </linearGradient>

      <!-- Daylight Volumetric Cathedral Sunbeams -->
      <linearGradient id="windowSunbeam" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#f7e1b5" stop-opacity="0.52" />
        <stop offset="45%" stop-color="#f2cc8f" stop-opacity="0.24" />
        <stop offset="100%" stop-color="#f2cc8f" stop-opacity="0" />
      </linearGradient>

      <!-- Nocturnal Banker's Lamp Volumetric Light Cone -->
      <radialGradient id="deskLampGlow" cx="38%" cy="22%" r="68%">
        <stop offset="0%" stop-color="#fae3b4" stop-opacity="0.88" />
        <stop offset="32%" stop-color="#f2cc8f" stop-opacity="0.45" />
        <stop offset="68%" stop-color="#e07a5f" stop-opacity="0.14" />
        <stop offset="100%" stop-color="#181924" stop-opacity="0" />
      </radialGradient>

      <!-- Brass Picture Sconce Warm Wash -->
      <radialGradient id="sconceGlow" cx="50%" cy="10%" r="80%">
        <stop offset="0%" stop-color="#f7dfa8" stop-opacity="0.78" />
        <stop offset="48%" stop-color="#f2cc8f" stop-opacity="0.28" />
        <stop offset="100%" stop-color="#f2cc8f" stop-opacity="0" />
      </radialGradient>

      <!-- Room Vignette for Cozy Study Depth -->
      <radialGradient id="roomVignette" cx="50%" cy="48%" r="65%">
        <stop offset="60%" stop-color="#000000" stop-opacity="0" />
        <stop offset="100%" stop-color="#0d0907" stop-opacity="0.42" />
      </radialGradient>
    </defs>

    <!-- ==================== 1. STUDY ROOM BACK WALL & WAINSCOTING ==================== -->
    <rect
      x="0"
      y="0"
      width="1200"
      height="408"
      class="room-wall-bg"
    />

    <!-- Subtle Heritage Boiserie Wall Molding Panels -->
    <g class="wall-boiserie" opacity="0.32">
      <rect x="30" y="24" width="235" height="250" rx="2" stroke="var(--border-strong)" stroke-width="1.5" />
      <rect x="285" y="24" width="260" height="250" rx="2" stroke="var(--border-strong)" stroke-width="1.5" />
      <rect x="565" y="24" width="605" height="250" rx="2" stroke="var(--border-strong)" stroke-width="1.5" />
    </g>

    <!-- Upper Crown Molding Cornice -->
    <rect x="0" y="0" width="1200" height="14" fill="url(#walnutDark)" />
    <line x1="0" y1="14" x2="1200" y2="14" stroke="#c49240" stroke-width="1.2" opacity="0.55" />

    <!-- Lower Carved Walnut Wainscoting (y: 286 -> 408) -->
    <rect x="0" y="286" width="1200" height="122" fill="var(--room-wainscot)" />
    <rect x="0" y="282" width="1200" height="7" fill="url(#walnutSurface)" stroke="#241710" stroke-width="1" />
    <!-- Recessed Wainscot Wood Panels -->
    <g fill="var(--room-wainscot-panel)" stroke="#63412c" stroke-width="1.2">
      <rect x="28" y="302" width="130" height="84" rx="2" />
      <rect x="178" y="302" width="130" height="84" rx="2" />
      <rect x="328" y="302" width="130" height="84" rx="2" />
      <rect x="478" y="302" width="130" height="84" rx="2" />
      <rect x="628" y="302" width="130" height="84" rx="2" />
      <rect x="778" y="302" width="130" height="84" rx="2" />
      <rect x="928" y="302" width="130" height="84" rx="2" />
      <rect x="1078" y="302" width="94" height="84" rx="2" />
    </g>
    <!-- Baseboard Molding -->
    <rect x="0" y="396" width="1200" height="14" fill="#241710" />

    <!-- ==================== 2. WOODEN FLOORS & ARTISTIC PERSIAN CARPET ==================== -->
    <!-- Hardwood Floor Background -->
    <rect x="0" y="408" width="1200" height="192" class="room-floor-bg" />

    <!-- Perspective Wooden Floor Planks & Grain Lines -->
    <g stroke="#241710" stroke-width="1.2" opacity="0.45">
      <line x1="0" y1="432" x2="1200" y2="432" />
      <line x1="0" y1="460" x2="1200" y2="460" />
      <line x1="0" y1="494" x2="1200" y2="494" />
      <line x1="0" y1="536" x2="1200" y2="536" />
      <line x1="0" y1="584" x2="1200" y2="584" />
      <!-- Perspective Plank Joints -->
      <line x1="180" y1="408" x2="60" y2="600" />
      <line x1="360" y1="408" x2="270" y2="600" />
      <line x1="540" y1="408" x2="500" y2="600" />
      <line x1="680" y1="408" x2="720" y2="600" />
      <line x1="860" y1="408" x2="950" y2="600" />
      <line x1="1040" y1="408" x2="1160" y2="600" />
    </g>

    <!-- ARTISTIC WOVEN PERSIAN / KILIM STUDY CARPET (In Perspective) -->
    <g class="artistic-study-carpet">
      <!-- Carpet Drop Shadow on Wooden Floor -->
      <polygon
        points="148,456 1052,456 1138,592 62,592"
        fill="#140c07"
        opacity="0.45"
      />
      <!-- Carpet Fringe Tassels (Left & Right) -->
      <path
        d="M144,458 L130,458 M136,472 L120,472 M126,486 L110,486 M116,502 L98,502 M104,518 L86,518 M94,534 L74,534 M82,552 L62,552 M72,570 L50,570 M64,586 L42,586"
        stroke="#f4f1de"
        stroke-width="2.5"
        stroke-linecap="round"
        opacity="0.8"
      />
      <path
        d="M1056,458 L1070,458 M1064,472 L1080,472 M1074,486 L1090,486 M1084,502 L1102,502 M1096,518 L1114,518 M1106,534 L1126,534 M1118,552 L1138,552 M1128,570 L1150,570 M1136,586 L1158,586"
        stroke="#f4f1de"
        stroke-width="2.5"
        stroke-linecap="round"
        opacity="0.8"
      />

      <!-- Outer Crimson / Burnt Peach Woven Field -->
      <polygon
        points="146,452 1054,452 1134,588 66,588"
        fill="#b85035"
        stroke="#f2cc8f"
        stroke-width="2.2"
      />
      <!-- Guard Border in Twilight Indigo -->
      <polygon
        points="168,462 1032,462 1102,578 98,578"
        fill="#3d405b"
        stroke="#f2cc8f"
        stroke-width="1.6"
      />
      <!-- Inner Muted Teal & Terracotta Sanctuary Field -->
      <polygon
        points="196,472 1004,472 1064,568 136,568"
        fill="#e07a5f"
        stroke="#81b29a"
        stroke-width="2"
      />
      <!-- Corner Geometric Spandrels -->
      <polygon points="196,472 285,472 165,568 136,568" fill="#81b29a" opacity="0.85" />
      <polygon points="1004,472 915,472 1035,568 1064,568" fill="#81b29a" opacity="0.85" />

      <!-- Central Persian Medallion & Geometric Kilim Motifs -->
      <polygon
        points="600,478 755,520 600,562 445,520"
        fill="#3d405b"
        stroke="#f2cc8f"
        stroke-width="2.2"
      />
      <polygon
        points="600,490 700,520 600,550 500,520"
        fill="#81b29a"
        stroke="#faf8ef"
        stroke-width="1.5"
      />
      <polygon
        points="600,502 648,520 600,538 552,520"
        fill="#f2cc8f"
        stroke="#3d405b"
        stroke-width="1.4"
      />
      <!-- Side Geometric Diamond Motifs on Carpet -->
      <polygon points="345,504 390,520 345,536 300,520" fill="#f2cc8f" stroke="#3d405b" stroke-width="1.3" />
      <polygon points="855,504 900,520 855,536 810,520" fill="#f2cc8f" stroke="#3d405b" stroke-width="1.3" />
    </g>

    <!-- ==================== 3. TALL ARCHED STUDY WINDOW (LEFT WALL) ==================== -->
    <g class="study-window">
      <!-- Outer Carved Walnut Window Frame -->
      <path
        d="M52 282 V112 C52 54, 244 54, 244 112 V282 Z"
        fill="#241710"
        stroke="url(#brassGold)"
        stroke-width="2"
      />
      <!-- Window Sky Canvas (Daylight vs. Nighttime) -->
      <path
        d="M64 274 V114 C64 66, 232 66, 232 114 V274 Z"
        class="window-sky-fill"
      />

      <!-- DAYLIGHT SKY DETAILS: Golden Sun & Soft Clouds -->
      <g class="daylight-window-scene">
        <circle cx="122" cy="118" r="24" fill="#f2cc8f" opacity="0.92" />
        <circle cx="122" cy="118" r="36" fill="#f2cc8f" opacity="0.28" />
        <path
          d="M82 175 C95 165, 118 165, 130 175 C144 168, 168 170, 178 182 H76 Z"
          fill="#faf8ef"
          opacity="0.7"
        />
        <!-- Distant Campus Spire / Tree Silhouette -->
        <path
          d="M64 274 L95 235 L118 258 L155 215 L188 252 L212 232 L232 274 Z"
          fill="#81b29a"
          opacity="0.38"
        />
      </g>

      <!-- NOCTURNAL SKY DETAILS: Crescent Moon & Twinkling Stars -->
      <g class="nocturnal-window-scene">
        <!-- Glowing Crescent Moon -->
        <path
          d="M132 96 A20 20 0 1 0 154 126 A16 16 0 1 1 132 96 Z"
          fill="#f2cc8f"
        />
        <!-- Animated Twinkling Stars -->
        <circle class="star s1" cx="92" cy="108" r="1.8" fill="#faf8ef" />
        <circle class="star s2" cx="188" cy="98" r="2.1" fill="#f2cc8f" />
        <circle class="star s3" cx="204" cy="146" r="1.5" fill="#faf8ef" />
        <circle class="star s4" cx="88" cy="168" r="1.7" fill="#81b29a" />
        <circle class="star s5" cx="152" cy="162" r="1.9" fill="#faf8ef" />
        <circle class="star s6" cx="115" cy="208" r="1.4" fill="#f2cc8f" />
        <circle class="star s7" cx="192" cy="212" r="1.8" fill="#faf8ef" />
        <!-- Distant Night Silhouette -->
        <path
          d="M64 274 L95 238 L118 258 L155 218 L188 252 L212 235 L232 274 Z"
          fill="#111320"
          opacity="0.85"
        />
      </g>

      <!-- Wooden Window Mullions (Arched Lattice) -->
      <line x1="148" y1="68" x2="148" y2="274" stroke="#3b2518" stroke-width="5" />
      <line x1="64" y1="148" x2="232" y2="148" stroke="#3b2518" stroke-width="5" />
      <line x1="64" y1="212" x2="232" y2="212" stroke="#3b2518" stroke-width="5" />
      <rect x="44" y="274" width="208" height="12" rx="2" fill="url(#walnutSurface)" stroke="#241710" stroke-width="1.2" />
    </g>

    <!-- ==================== 4. BUILT-IN WALL BOOKSHELF (CENTER-LEFT WALL) ==================== -->
    <g class="wall-bookshelf">
      <!-- Recessed Mahogany Bookcase Frame -->
      <rect
        x="294"
        y="46"
        width="232"
        height="228"
        rx="3"
        fill="#26170e"
        stroke="url(#walnutSurface)"
        stroke-width="6"
      />
      <!-- Shelf Boards -->
      <rect x="294" y="124" width="232" height="8" fill="url(#walnutSurface)" />
      <rect x="294" y="198" width="232" height="8" fill="url(#walnutSurface)" />
      <rect x="286" y="270" width="248" height="10" rx="2" fill="url(#walnutSurface)" />

      <!-- Top Shelf: Brass Terrestrial Globe, Hourglass & Volumes -->
      <!-- Brass Globe -->
      <circle cx="336" cy="92" r="18" fill="#81b29a" stroke="#3d405b" stroke-width="1.4" />
      <path d="M322 78 A22 22 0 0 1 350 108" stroke="url(#brassGold)" stroke-width="2.5" fill="none" />
      <line x1="336" y1="112" x2="336" y2="124" stroke="url(#brassGold)" stroke-width="3" />
      <rect x="324" y="120" width="24" height="4" fill="url(#brassGold)" />
      <!-- Top Shelf Books -->
      <rect x="372" y="68" width="18" height="56" rx="1.5" fill="#e07a5f" stroke="#241710" stroke-width="1" />
      <rect x="391" y="62" width="22" height="62" rx="1.5" fill="#3d405b" stroke="#241710" stroke-width="1" />
      <rect x="414" y="70" width="16" height="54" rx="1.5" fill="#f2cc8f" stroke="#241710" stroke-width="1" />
      <rect x="431" y="64" width="20" height="60" rx="1.5" fill="#81b29a" stroke="#241710" stroke-width="1" />
      <g transform="translate(462, 68) rotate(10)">
        <rect x="0" y="0" width="18" height="56" rx="1.5" fill="#b85035" stroke="#241710" stroke-width="1" />
      </g>

      <!-- Middle Shelf: Bound Research Volumes (MARL, ADS-C, LLMs) -->
      <rect x="308" y="140" width="22" height="58" rx="1.5" fill="#3d405b" stroke="#241710" stroke-width="1" />
      <rect x="331" y="136" width="24" height="62" rx="1.5" fill="#e07a5f" stroke="#241710" stroke-width="1" />
      <rect x="356" y="142" width="19" height="56" rx="1.5" fill="#81b29a" stroke="#241710" stroke-width="1" />
      <rect x="376" y="138" width="25" height="60" rx="1.5" fill="#6e4830" stroke="#241710" stroke-width="1" />
      <rect x="402" y="144" width="18" height="54" rx="1.5" fill="#f2cc8f" stroke="#241710" stroke-width="1" />
      <rect x="421" y="136" width="22" height="62" rx="1.5" fill="#3d405b" stroke="#241710" stroke-width="1" />
      <!-- Brass Hourglass on Middle Shelf -->
      <polygon points="468,152 492,152 480,174 492,196 468,196 480,174" fill="#f2cc8f" opacity="0.75" stroke="url(#brassGold)" stroke-width="1.6" />

      <!-- Bottom Shelf: Large Folio Ledgers & Teras/Keras Boxes -->
      <rect x="310" y="212" width="26" height="58" rx="1.5" fill="#81b29a" stroke="#241710" stroke-width="1" />
      <rect x="338" y="210" width="28" height="60" rx="1.5" fill="#e07a5f" stroke="#241710" stroke-width="1" />
      <rect x="368" y="214" width="22" height="56" rx="1.5" fill="#3d405b" stroke="#241710" stroke-width="1" />
      <!-- Horizontal Stacked Folios -->
      <rect x="406" y="252" width="96" height="16" rx="2" fill="#e07a5f" stroke="#241710" stroke-width="1" />
      <rect x="412" y="236" width="86" height="15" rx="2" fill="#f2cc8f" stroke="#241710" stroke-width="1" />
      <rect x="418" y="221" width="76" height="14" rx="2" fill="#81b29a" stroke="#241710" stroke-width="1" />
    </g>

    <!-- ==================== 5. THREE INTERACTIVE FRAMED PORTRAITS ON STUDY WALL ==================== -->
    <!-- PORTRAIT I: U.S. FULBRIGHT SCHOLAR CHARTER (x: 565 -> 740) -->
    <g
      class="wall-portrait-group"
      data-room-hotspot="fulbright"
      tabindex="0"
      role="button"
      aria-label="Inspect U.S. Fulbright Scholar wall portrait (4.0 GPA at RIT)"
    >
      <!-- Brass Picture Light Above Portrait I -->
      <rect x="622" y="34" width="60" height="7" rx="3" fill="url(#brassGold)" stroke="#241710" stroke-width="1" />
      <line x1="652" y1="41" x2="652" y2="54" stroke="url(#brassGold)" stroke-width="3" />
      <!-- Warm Picture Light Cone -->
      <polygon
        class="portrait-light-cone"
        points="622,41 555,255 750,255 682,41"
        fill="url(#sconceGlow)"
      />

      <!-- Ornate Walnut & Gilt Portrait Frame -->
      <rect
        x="568"
        y="54"
        width="168"
        height="196"
        rx="4"
        fill="url(#walnutDark)"
        stroke="url(#brassGold)"
        stroke-width="3"
        class="portrait-frame-box"
      />
      <!-- Cream Museum Matting -->
      <rect
        x="580"
        y="66"
        width="144"
        height="152"
        rx="2"
        fill="#faf8ef"
        stroke="#c49240"
        stroke-width="1.2"
      />
      <!-- Fulbright Globe & Torch Medallion Artwork -->
      <circle cx="652" cy="118" r="28" fill="#e07a5f" opacity="0.16" />
      <circle cx="652" cy="118" r="22" fill="none" stroke="#b85035" stroke-width="1.6" />
      <ellipse cx="652" cy="118" rx="11" ry="22" fill="none" stroke="#b85035" stroke-width="1.2" />
      <line x1="630" y1="118" x2="674" y2="118" stroke="#b85035" stroke-width="1.2" />
      <line x1="652" y1="96" x2="652" y2="140" stroke="#b85035" stroke-width="1.2" />
      <!-- Calligraphic Charter Title inside Portrait -->
      <text
        x="652"
        y="162"
        fill="#232536"
        font-family="var(--font-mono)"
        font-size="9.5"
        font-weight="700"
        letter-spacing="1.4"
        text-anchor="middle"
      >
        U.S. FULBRIGHT
      </text>
      <text
        x="652"
        y="177"
        fill="#b85035"
        font-family="var(--font-display)"
        font-size="11.5"
        font-weight="600"
        text-anchor="middle"
      >
        4.0 / 4.0 M.S. AI · RIT
      </text>
      <text
        x="652"
        y="194"
        fill="#52556e"
        font-family="var(--font-mono)"
        font-size="7.5"
        letter-spacing="0.8"
        text-anchor="middle"
      >
        1ST RANK B.S. CS ’21
      </text>
      <!-- Wax Seal on Charter -->
      <circle cx="702" cy="196" r="9" fill="#e07a5f" stroke="#f2cc8f" stroke-width="1.2" />
      <!-- Brass Curator Plaque on Bottom Frame -->
      <rect x="594" y="226" width="116" height="16" rx="2" fill="url(#brassPlaqueFace)" stroke="#241710" stroke-width="1" />
      <text
        x="652"
        y="237"
        fill="#241710"
        font-family="var(--font-mono)"
        font-size="7.5"
        font-weight="700"
        letter-spacing="0.9"
        text-anchor="middle"
      >
        FULBRIGHT SCHOLAR
      </text>
    </g>

    <!-- PORTRAIT II: AMAZON WEB SERVICES (AWS) AI/ML COMMENDATION (x: 766 -> 942) -->
    <g
      class="wall-portrait-group"
      data-room-hotspot="aws"
      tabindex="0"
      role="button"
      aria-label="Inspect Amazon Web Services AI/ML Intern wall portrait (Full-Time Return Offer)"
    >
      <!-- Brass Picture Light Above Portrait II -->
      <rect x="824" y="34" width="60" height="7" rx="3" fill="url(#brassGold)" stroke="#241710" stroke-width="1" />
      <line x1="854" y1="41" x2="854" y2="54" stroke="url(#brassGold)" stroke-width="3" />
      <polygon
        class="portrait-light-cone"
        points="824,41 757,255 952,255 884,41"
        fill="url(#sconceGlow)"
      />

      <!-- Ornate Walnut & Brass Portrait Frame -->
      <rect
        x="770"
        y="54"
        width="168"
        height="196"
        rx="4"
        fill="url(#walnutDark)"
        stroke="url(#brassGold)"
        stroke-width="3"
        class="portrait-frame-box"
      />
      <!-- Deep Indigo & Gold Museum Matting -->
      <rect
        x="782"
        y="66"
        width="144"
        height="152"
        rx="2"
        fill="#2b2e44"
        stroke="#f2cc8f"
        stroke-width="1.2"
      />
      <!-- AWS Spark Cluster & Return Offer Star Emblem -->
      <circle cx="854" cy="116" r="25" fill="rgba(242, 204, 143, 0.14)" stroke="#f2cc8f" stroke-width="1.5" />
      <polygon
        points="854,97 860,110 874,111 863,120 866,134 854,126 842,134 845,120 834,111 848,110"
        fill="#f2cc8f"
      />
      <text
        x="854"
        y="161"
        fill="#faf8ef"
        font-family="var(--font-mono)"
        font-size="9.5"
        font-weight="700"
        letter-spacing="1.4"
        text-anchor="middle"
      >
