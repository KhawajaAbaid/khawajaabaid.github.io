<style>
  .study-room-stage {
    position: relative;
    width: 100%;
    border-radius: 8px 8px 0 0;
    overflow: hidden;
    border: 2px solid var(--wood-mid);
    border-bottom: 0;
    background: var(--room-wall-top);
    box-shadow:
      0 18px 44px -12px rgba(24, 15, 10, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
    isolation: isolate;
  }

  .study-room-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Wall & Floor Dynamic Lighting Surfaces */
  .room-wall-bg {
    fill: var(--room-wall-top);
    transition: fill 480ms ease;
  }

  .room-floor-bg {
    fill: var(--room-floor-1);
    transition: fill 480ms ease;
  }

  /* Window Sky Day/Night Transition */
  .window-sky-fill {
    fill: #d8e8e4;
    transition: fill 480ms ease;
  }

  :root[data-theme="dark"] .window-sky-fill,
  :root:has(> head > meta[name="color-scheme"][content="dark"])
    .window-sky-fill {
    fill: #131629;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]):not(
        :has(> head > meta[name="color-scheme"][content="light"])
      )
      .window-sky-fill {
      fill: #131629;
    }
  }

  .daylight-window-scene,
  .daylight-volumetric-rays,
  .daylight-dust-motes {
    opacity: var(--sunbeam-opacity);
    transition: opacity 480ms ease;
    pointer-events: none;
  }

  .nocturnal-window-scene {
    opacity: calc(1 - var(--sunbeam-opacity));
    transition: opacity 480ms ease;
    pointer-events: none;
  }

  .nocturnal-lamp-cone {
    opacity: var(--lamp-cone-opacity);
    transition: opacity 480ms ease;
    pointer-events: none;
  }

  /* Picture Sconce Cones Over the 3 Framed Portraits */
  .portrait-light-cone {
    opacity: calc(0.22 + 0.65 * var(--lamp-cone-opacity));
    transition: opacity 320ms ease;
    pointer-events: none;
  }

  /* Interactive Bookcase Navigation Shelves & Open Desk Ledger */
  .bookshelf-nav-link,
  .desk-open-ledger {
    cursor: pointer;
    transition:
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 240ms ease;
  }

  .bookshelf-nav-link:hover,
  .bookshelf-nav-link:focus-visible {
    transform: translateX(4px);
    filter: drop-shadow(0 4px 12px rgba(242, 204, 143, 0.45));
    outline: none;
  }

  .bookshelf-nav-link:hover .shelf-plaque-box,
  .bookshelf-nav-link:focus-visible .shelf-plaque-box {
    fill: #4d2f1c;
    stroke: #faf8ef;
  }

  .desk-open-ledger:hover,
  .desk-open-ledger:focus-visible {
    transform: translateY(-3px);
    filter: drop-shadow(0 6px 14px rgba(242, 204, 143, 0.5));
    outline: none;
  }

  /* Interactive Framed Wall Portraits & Desk Nameplate Hotspots */
  .wall-portrait-group,
  .desk-nameplate-group {
    cursor: pointer;
    transition:
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 280ms ease;
  }

  .wall-portrait-group:hover,
  .wall-portrait-group:focus-visible,
  .wall-portrait-group.active-hotspot {
    transform: translateY(-4px);
    filter: drop-shadow(0 8px 18px rgba(242, 204, 143, 0.42));
    outline: none;
  }

  .wall-portrait-group:hover .portrait-light-cone,
  .wall-portrait-group.active-hotspot .portrait-light-cone {
    opacity: 1;
  }

  .desk-nameplate-group:hover,
  .desk-nameplate-group:focus-visible,
  .desk-nameplate-group.active-hotspot {
    transform: translateY(-3px);
    filter: drop-shadow(0 6px 16px rgba(242, 204, 143, 0.5));
    outline: none;
  }

  /* Floating Dust Motes Animation in Sunbeams */
  .mote {
    animation: driftMote 9s ease-in-out infinite alternate;
  }
  .m2 {
    animation-duration: 11s;
    animation-delay: -2s;
  }
  .m3 {
    animation-duration: 8s;
    animation-delay: -4s;
  }
  .m4 {
    animation-duration: 12s;
    animation-delay: -1s;
  }
  .m5 {
    animation-duration: 10s;
    animation-delay: -5s;
  }
  .m6 {
    animation-duration: 9.5s;
    animation-delay: -3s;
  }
  .m7 {
    animation-duration: 11.5s;
    animation-delay: -6s;
  }

  @keyframes driftMote {
    0% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(8px, -10px);
    }
    100% {
      transform: translate(-6px, 6px);
    }
  }

  /* Twinkling Night Stars in Window */
  .star {
    animation: twinkleStar 4s ease-in-out infinite alternate;
  }
  .s2,
  .s5 {
    animation-duration: 5.5s;
    animation-delay: -1.5s;
  }
  .s3,
  .s6 {
    animation-duration: 3.5s;
    animation-delay: -2.8s;
  }

  @keyframes twinkleStar {
    0% {
      opacity: 0.3;
      transform: scale(0.85);
    }
    100% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  /* Rising Steam from Teacup on Desk */
  .steam-wisp {
    animation: riseSteam 5s ease-in-out infinite;
  }
  .w2 {
    animation-delay: -2.5s;
  }

  @keyframes riseSteam {
    0% {
      opacity: 0;
      transform: translateY(3px);
    }
    50% {
      opacity: 0.65;
    }
    100% {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  /* Interactive Beaded Brass Lamp Pull-Chain */
  .lamp-chain-interactive {
    cursor: pointer;
    outline: none;
  }

  .lamp-pull-chain {
    transition:
      transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 220ms ease;
  }

  .acorn-halo {
    transition:
      opacity 220ms ease,
      transform 220ms ease;
    transform-origin: 340px 325px;
  }

  .lamp-chain-interactive:hover .lamp-pull-chain,
  .lamp-chain-interactive:focus-visible .lamp-pull-chain {
    transform: translateY(6px);
    filter: drop-shadow(0 4px 10px rgba(242, 204, 143, 0.65));
  }

  .lamp-chain-interactive:hover .acorn-halo,
  .lamp-chain-interactive:focus-visible .acorn-halo {
    opacity: 0.55;
    transform: scale(1.3);
  }

  .study-room-stage.lamp-switching .lamp-pull-chain {
    animation: roomChainBounce 480ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes roomChainBounce {
    0% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(15px);
    }
    100% {
      transform: translateY(0);
    }
  }
</style>
