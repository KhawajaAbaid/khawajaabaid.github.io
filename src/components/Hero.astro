---
import { profile } from "../data/profile";
import NetworkMotif from "./NetworkMotif.astro";
---

<section class="study-hero" aria-labelledby="hero-name" data-hero-study>
  <!-- TOP: THE ANIMATED OLD-SCHOOL CLASSIC STUDY ROOM PANORAMA -->
  <NetworkMotif />

  <!-- BOTTOM: THE CARVED WALNUT DESK LEDGE & INTERACTIVE SCHOLAR'S BLOTTER -->
  <div class="desk-blotter-console">
    <!-- Tactile Brass Plaque Selector Rail (Synced with Wall Portraits & Desk Nameplate in Room) -->
    <div
      class="room-plaque-tabs"
      role="tablist"
      aria-label="Inspect objects in the study room"
    >
      <button
        type="button"
        role="tab"
        id="room-tab-identity"
        aria-controls="room-panel-identity"
        aria-selected="true"
        data-plaque-tab="identity"
        class="plaque-tab active"
      >
        <span class="plaque-kicker">DESK NAMEPLATE</span>
        <span class="plaque-title">Khawaja Abaid Ullah</span>
      </button>

      <button
        type="button"
        role="tab"
        id="room-tab-fulbright"
        aria-controls="room-panel-fulbright"
        aria-selected="false"
        data-plaque-tab="fulbright"
        class="plaque-tab"
      >
        <span class="plaque-kicker">WALL PORTRAIT I</span>
        <span class="plaque-title">U.S. Fulbright Scholar · 4.0 GPA</span>
      </button>

      <button
        type="button"
        role="tab"
        id="room-tab-aws"
        aria-controls="room-panel-aws"
        aria-selected="false"
        data-plaque-tab="aws"
        class="plaque-tab"
      >
        <span class="plaque-kicker">WALL PORTRAIT II</span>
        <span class="plaque-title">AWS AI/ML · ★ Return Offer</span>
      </button>

      <button
        type="button"
        role="tab"
        id="room-tab-kaslab"
        aria-controls="room-panel-kaslab"
        aria-selected="false"
        data-plaque-tab="kaslab"
        class="plaque-tab"
      >
        <span class="plaque-kicker">WALL PORTRAIT III</span>
        <span class="plaque-title">KAS Lab Ph.D. &amp; Open-Source ML</span>
      </button>

      <button
        type="button"
        role="tab"
        id="room-tab-robots"
        aria-controls="room-panel-robots"
        aria-selected="false"
        data-plaque-tab="robots"
        class="plaque-tab plaque-tab-robots"
      >
        <span class="plaque-kicker">
          <span class="plaque-live-dot" aria-hidden="true"></span>
          OPEN-WINDOW SWARM
        </span>
        <span class="plaque-title">Mosquito Intercept · MARL</span>
      </button>
    </div>

    <!-- Desk Blotter Inspection Surface -->
    <div class="blotter-surface">
      <!-- PANEL 1: DESK NAMEPLATE (PRIMARY IDENTITY & OVERVIEW) -->
      <div
        role="tabpanel"
        id="room-panel-identity"
        aria-labelledby="room-tab-identity"
        data-plaque-panel="identity"
        class="blotter-panel active"
      >
        <div class="blotter-grid">
          <div class="blotter-main">
            <div class="engraved-badge-row">
              <span class="brass-tag">
                ENGRAVED DESK PLATE // RIT · KAS LAB · ROCHESTER, NY
              </span>
              <span class="brass-tag teal">PH.D. GRA · FULL FELLOWSHIP</span>
            </div>

            <h1 id="hero-name">
              Khawaja Abaid Ullah<span class="accent">.</span>
            </h1>

            <p class="blotter-lead">
              Ph.D. researcher at RIT’s{" "}
              <strong>
                Khojasteh Autonomous Systems Laboratory (KAS Lab)
              </strong>{" "}
              investigating{" "}
              <strong>
                multi-agent coordination, dynamic resource allocation,
                constrained communication, and compromised-agent containment
              </strong>{" "}
              for autonomous disaster search-and-rescue robot teams—alongside{" "}
              <strong>test-time antidistillation defenses</strong> against model
              extraction.
            </p>
          </div>

          <div class="blotter-aside">
            <div class="study-distinctions-summary">
              <div class="mini-plaque">
                <span class="mini-logo-badge" aria-hidden="true">
                  <svg viewBox="0 0 36 36" width="32" height="32">
                    <circle cx="18" cy="18" r="15" fill="#3d405b" />
                    <path d="M5 12 A15 15 0 0 1 31 12 Q18 17 5 12 Z" fill="#81b29a" />
                    <path d="M9 7 A15 15 0 0 1 27 7 Q18 11 9 7 Z" fill="#f2cc8f" />
                    <path d="M3 18 Q18 13 33 18 Q18 24 3 18 Z" fill="#e07a5f" />
                    <circle cx="18" cy="18" r="15" fill="none" stroke="#c49240" stroke-width="1.2" />
                    <path d="M13 4 C9.5 13, 9.5 23, 13 32" fill="none" stroke="#faf8ef" stroke-width="1.6" stroke-linecap="round" />
                    <path d="M5.5 12 Q18 8.5 30.5 12" fill="none" stroke="#faf8ef" stroke-width="1.4" stroke-linecap="round" />
                    <path d="M4 19 Q18 15.5 28 19" fill="none" stroke="#faf8ef" stroke-width="1.4" stroke-linecap="round" />
                  </svg>
                </span>
                <div class="mini-plaque-copy">
                  <span class="mini-label">U.S. DEPT. OF STATE</span>
                  <strong>Fulbright Scholar (4.0 / 4.0 GPA)</strong>
                  <span>M.S. in AI at RIT · 1st in B.S. CS Class of 2021</span>
                </div>
              </div>
              <div class="mini-plaque">
                <span class="mini-logo-badge aws-badge" aria-hidden="true">
                  <svg viewBox="0 0 304 182" width="34" height="22">
                    <path
                      fill="currentColor"
                      d="M86.4,66.4c0,3.7,0.4,6.7,1.1,8.9c0.8,2.2,1.8,4.6,3.2,7.2c0.5,0.8,0.7,1.6,0.7,2.3c0,1-0.6,2-1.9,3l-6.3,4.2c-0.9,0.6-1.8,0.9-2.6,0.9c-1,0-2-0.5-3-1.4C76.2,90,75,88.4,74,86.8c-1-1.7-2-3.6-3.1-5.9c-7.8,9.2-17.6,13.8-29.4,13.8c-8.4,0-15.1-2.4-20-7.2c-4.9-4.8-7.4-11.2-7.4-19.2c0-8.5,3-15.4,9.1-20.6c6.1-5.2,14.2-7.8,24.5-7.8c3.4,0,6.9,0.3,10.6,0.8c3.7,0.5,7.5,1.3,11.5,2.2v-7.3c0-7.6-1.6-12.9-4.7-16c-3.2-3.1-8.6-4.6-16.3-4.6c-3.5,0-7.1,0.4-10.8,1.3c-3.7,0.9-7.3,2-10.8,3.4c-1.6,0.7-2.8,1.1-3.5,1.3c-0.7,0.2-1.2,0.3-1.6,0.3c-1.4,0-2.1-1-2.1-3.1v-4.9c0-1.6,0.2-2.8,0.7-3.5c0.5-0.7,1.4-1.4,2.8-2.1c3.5-1.8,7.7-3.3,12.6-4.5c4.9-1.3,10.1-1.9,15.6-1.9c11.9,0,20.6,2.7,26.2,8.1c5.5,5.4,8.3,13.6,8.3,24.6V66.4z M45.8,81.6c3.3,0,6.7-0.6,10.3-1.8c3.6-1.2,6.8-3.4,9.5-6.4c1.6-1.9,2.8-4,3.4-6.4c0.6-2.4,1-5.3,1-8.7v-4.2c-2.9-0.7-6-1.3-9.2-1.7c-3.2-0.4-6.3-0.6-9.4-0.6c-6.7,0-11.6,1.3-14.9,4c-3.3,2.7-4.9,6.5-4.9,11.5c0,4.7,1.2,8.2,3.7,10.6C37.7,80.4,41.2,81.6,45.8,81.6z M126.1,92.4c-1.8,0-3-0.3-3.8-1c-0.8-0.6-1.5-2-2.1-3.9L96.7,10.2c-0.6-2-0.9-3.3-0.9-4c0-1.6,0.8-2.5,2.4-2.5h9.8c1.9,0,3.2,0.3,3.9,1c0.8,0.6,1.4,2,2,3.9l16.8,66.2l15.6-66.2c0.5-2,1.1-3.3,1.9-3.9c0.8-0.6,2.2-1,4-1h8c1.9,0,3.2,0.3,4,1c0.8,0.6,1.5,2,1.9,3.9l15.8,67l17.3-67c0.6-2,1.3-3.3,2-3.9c0.8-0.6,2.1-1,3.9-1h9.3c1.6,0,2.5,0.8,2.5,2.5c0,0.5-0.1,1-0.2,1.6c-0.1,0.6-0.3,1.4-0.7,2.5l-24.1,77.3c-0.6,2-1.3,3.3-2.1,3.9c-0.8,0.6-2.1,1-3.8,1h-8.6c-1.9,0-3.2-0.3-4-1c-0.8-0.7-1.5-2-1.9-4L156,23l-15.4,64.4c-0.5,2-1.1,3.3-1.9,4c-0.8,0.7-2.2,1-4,1H126.1z M254.6,95.1c-5.2,0-10.4-0.6-15.4-1.8c-5-1.2-8.9-2.5-11.5-4c-1.6-0.9-2.7-1.9-3.1-2.8c-0.4-0.9-0.6-1.9-0.6-2.8v-5.1c0-2.1,0.8-3.1,2.3-3.1c0.6,0,1.2,0.1,1.8,0.3c0.6,0.2,1.5,0.6,2.5,1c3.4,1.5,7.1,2.7,11,3.5c4,0.8,7.9,1.2,11.9,1.2c6.3,0,11.2-1.1,14.6-3.3c3.4-2.2,5.2-5.4,5.2-9.5c0-2.8-0.9-5.1-2.7-7c-1.8-1.9-5.2-3.6-10.1-5.2L246,52c-7.3-2.3-12.7-5.7-16-10.2c-3.3-4.4-5-9.3-5-14.5c0-4.2,0.9-7.9,2.7-11.1c1.8-3.2,4.2-6,7.2-8.2c3-2.3,6.4-4,10.4-5.2c4-1.2,8.2-1.7,12.6-1.7c2.2,0,4.5,0.1,6.7,0.4c2.3,0.3,4.4,0.7,6.5,1.1c2,0.5,3.9,1,5.7,1.6c1.8,0.6,3.2,1.2,4.2,1.8c1.4,0.8,2.4,1.6,3,2.5c0.6,0.8,0.9,1.9,0.9,3.3v4.7c0,2.1-0.8,3.2-2.3,3.2c-0.8,0-2.1-0.4-3.8-1.2c-5.7-2.6-12.1-3.9-19.2-3.9c-5.7,0-10.2,0.9-13.3,2.8c-3.1,1.9-4.7,4.8-4.7,8.9c0,2.8,1,5.2,3,7.1c2,1.9,5.7,3.8,11,5.5l14.2,4.5c7.2,2.3,12.4,5.5,15.5,9.6c3.1,4.1,4.6,8.8,4.6,14c0,4.3-0.9,8.2-2.6,11.6c-1.8,3.4-4.2,6.4-7.3,8.8c-3.1,2.5-6.8,4.3-11.1,5.6C264.4,94.4,259.7,95.1,254.6,95.1z"
                    />
                    <path
                      fill="#e07a5f"
                      d="M273.5,143.7c-32.9,24.3-80.7,37.2-121.8,37.2c-57.6,0-109.5-21.3-148.7-56.7c-3.1-2.8-0.3-6.6,3.4-4.4c42.4,24.6,94.7,39.5,148.8,39.5c36.5,0,76.6-7.6,113.5-23.2C274.2,133.6,278.9,139.7,273.5,143.7z"
                    />
                    <path
                      fill="#e07a5f"
                      d="M287.2,128.1c-4.2-5.4-27.8-2.6-38.5-1.3c-3.2,0.4-3.7-2.4-0.8-4.5c18.8-13.2,49.7-9.4,53.3-5c3.6,4.5-1,35.4-18.6,50.2c-2.7,2.3-5.3,1.1-4.1-1.9C282.5,155.7,291.4,133.4,287.2,128.1z"
                    />
                  </svg>
                </span>
                <div class="mini-plaque-copy">
                  <span class="mini-label">AMAZON WEB SERVICES (AWS)</span>
                  <strong>AI/ML SDE Intern · Return Offer</strong>
                  <span>East Palo Alto, CA · Apache Spark Benchmarking</span>
                </div>
              </div>
              <div class="mini-plaque">
                <span class="mini-logo-badge" aria-hidden="true">
                  <svg viewBox="0 0 36 36" width="32" height="32">
                    <circle cx="18" cy="18" r="15" fill="rgba(129, 178, 154, 0.2)" stroke="#3c6953" stroke-width="1.3" />
                    <line x1="11" y1="13" x2="25" y2="12" stroke="#3d405b" stroke-width="1.5" />
                    <line x1="11" y1="13" x2="18" y2="25" stroke="#3d405b" stroke-width="1.5" />
                    <line x1="25" y1="12" x2="18" y2="25" stroke="#3d405b" stroke-width="1.5" />
                    <circle cx="11" cy="13" r="3.2" fill="#e07a5f" />
                    <circle cx="25" cy="12" r="3.2" fill="#3d405b" />
                    <circle cx="18" cy="25" r="3.2" fill="#81b29a" stroke="#232536" stroke-width="1" />
                  </svg>
                </span>
                <div class="mini-plaque-copy">
                  <span class="mini-label">RIT KAS LAB · OPEN-SOURCE ML</span>
                  <strong>Creator of Teras · Keras 3 · ADS-C</strong>
                  <span>−29.6 pp CIFAR-10 distillation at 0 pp top-1 cost</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="blotter-footer">
          <div class="links hero-links">
            <a class="wax-seal-btn" href="/cv.pdf">
              Curriculum Vitae (PDF) ↗
            </a>
            <button
              type="button"
              class="robot-sim-trigger-btn"
              data-jump-robots
            >
              <span class="plaque-live-dot" aria-hidden="true"></span>
              Mosquito Swarm Defense (MARL) →
            </button>
            <a href={profile.links.github}>GitHub ↗</a>
            <a href={profile.links.linkedin}>LinkedIn ↗</a>
            <a href={profile.links.rit}>RIT / KAS Lab ↗</a>
            <a href={`mailto:${profile.email}`}>{profile.email} ↗</a>
          </div>
          <p class="room-hint">
            Tip: Watch the <strong>open window</strong> for mosquito intruders &amp;
            autonomous swarm intercepts, select a{" "}
            <strong>bookcase shelf</strong>, or pull the{" "}
            <strong>brass lamp chain</strong>.
          </p>
        </div>
      </div>

      <!-- PANEL 2: PORTRAIT I — U.S. FULBRIGHT SCHOLAR -->
      <div
        role="tabpanel"
        id="room-panel-fulbright"
        aria-labelledby="room-tab-fulbright"
        data-plaque-panel="fulbright"
        class="blotter-panel"
        hidden
      >
        <div class="portrait-detail-view">
          <div class="portrait-detail-header">
            <span class="brass-tag">
              WALL PORTRAIT I // U.S. DEPARTMENT OF STATE FULBRIGHT SCHOLAR
            </span>
            <span class="brass-tag teal">AUG 2024 – MAY 2026 · 4.0 / 4.0 GPA</span>
          </div>

          <h2>
            M.S. in Artificial Intelligence · Rochester Institute of Technology
          </h2>

          <p class="blotter-lead">
            Selected for the flagship U.S. Department of State{" "}
            <strong>Fulbright Foreign Student Fellowship</strong> to pursue
            graduate research in Artificial Intelligence at RIT, graduating with
            a <strong>perfect 4.0 / 4.0 GPA</strong> and defending the Master’s
            thesis <em>“Antidistillation Sampling for Classification”</em>{" "}
            before continuing into a fully funded Ph.D. GRA in ECE at RIT’s KAS
            Lab. Previously graduated{" "}
            <strong>1st in the Computer Science class of 2021</strong> at the
            University of Narowal.
          </p>

          <div class="blotter-footer">
            <div class="links">
              <a class="wax-seal-btn" href="https://repository.rit.edu/theses/12584/">
                RIT Master’s Thesis ↗
              </a>
              <a href="/research/ads-c/">Open ADS-C Research Plate →</a>
              <a href="/about/">Full Academic Record →</a>
            </div>
          </div>
        </div>
      </div>

      <!-- PANEL 3: PORTRAIT II — AMAZON WEB SERVICES (AWS) -->
      <div
        role="tabpanel"
        id="room-panel-aws"
        aria-labelledby="room-tab-aws"
        data-plaque-panel="aws"
        class="blotter-panel"
        hidden
      >
        <div class="portrait-detail-view">
          <div class="portrait-detail-header">
            <span class="brass-tag">
              WALL PORTRAIT II // AMAZON WEB SERVICES (AWS) · EAST PALO ALTO, CA
            </span>
            <span class="brass-tag teal">★ FULL-TIME RETURN OFFER EARNED</span>
          </div>

          <h2>
            Software Development Engineer Intern, AI/ML · May – Aug 2025
          </h2>

          <p class="blotter-lead">
            Engineered core <strong>Apache Spark</strong> testing and
            evaluation modules for a next-generation internal benchmarking
            platform at <strong>Amazon Web Services (AWS)</strong> in East Palo
            Alto, closing feature-parity gaps with its legacy predecessor across
            targeted benchmarking workflows. Independently identified and
            delivered additional benchmarking capabilities beyond original
            project scope, earning strong leadership recognition and a{" "}
            <strong>full-time return offer</strong>.
          </p>

          <div class="blotter-footer">
            <div class="links">
              <a class="wax-seal-btn" href="/cv.pdf">
                Full Resume (PDF) ↗
              </a>
              <a href="/about/">Complete Industry &amp; Academic Dossier →</a>
              <a href="/projects/">Explore Open-Source ML Systems →</a>
            </div>
          </div>
        </div>
      </div>

      <!-- PANEL 4: PORTRAIT III — KAS LAB PH.D. & OPEN-SOURCE ML -->
      <div
        role="tabpanel"
        id="room-panel-kaslab"
        aria-labelledby="room-tab-kaslab"
        data-plaque-panel="kaslab"
        class="blotter-panel"
        hidden
      >
        <div class="portrait-detail-view">
          <div class="portrait-detail-header">
            <span class="brass-tag">
              WALL PORTRAIT III // KHOJASTEH AUTONOMOUS SYSTEMS LAB (KAS LAB)
            </span>
            <span class="brass-tag teal">
              MARL · ANTIDISTILLATION · TERAS &amp; KERAS 3
            </span>
          </div>

          <h2>
            Autonomous Disaster Search-and-Rescue, ML Security &amp; Open-Source
            Engines
          </h2>

          <p class="blotter-lead">
            Advised by <strong>Dr. Mohammad Javad Khojasteh</strong> at RIT’s
            KAS Lab, my Ph.D. research develops multi-agent reinforcement
            learning and coordination algorithms under energy, bandwidth, and
            adversarial constraints (<strong>Fontus</strong> in PettingZoo &amp;
            Ray RLlib), alongside inference-time antidistillation defenses (
            <strong>ADS-C</strong>: <strong>−29.6 pp</strong> student accuracy
            on CIFAR-10 at <strong>0 pp</strong> top-1 cost;{" "}
            <strong>−47.7 pp</strong> on CIFAR-100 in matched-cost review).
            Creator of <strong>Teras</strong> and official contributor to{" "}
            <strong>Keras 3</strong> across JAX, PyTorch, and TensorFlow.
          </p>

          <div class="blotter-footer">
            <div class="links">
              <a class="wax-seal-btn" href="/research/">
                Explore Research Wing →
              </a>
              <a href="/research/fontus/">Fontus MARL Study →</a>
              <a href="/research/ads-c/">ADS-C Security Study →</a>
              <a href="/projects/">Teras &amp; Keras 3 Code →</a>
            </div>
          </div>
        </div>
      </div>

      <!-- PANEL 5: OPEN-WINDOW MOSQUITO SWARM INTERCEPT (MARL) CONSOLE -->
      <div
        role="tabpanel"
        id="room-panel-robots"
        aria-labelledby="room-tab-robots"
        data-plaque-panel="robots"
        class="blotter-panel"
        hidden
      >
        <div class="portrait-detail-view marl-console-view">
          <div class="marl-console-top">
            <div>
              <div class="portrait-detail-header">
                <span class="brass-tag">
                  OPEN-WINDOW SWARM LOOP // DECENTRALIZED MULTI-AGENT INTERCEPT
                </span>
                <span class="brass-tag teal" data-swarm-live-phase>
                  SENTRY WATCH · READY
                </span>
              </div>
              <h2>
                Autonomous Detection, Mesh Broadcast &amp; Cooperative Task
                Neutralization
              </h2>
            </div>

            <div class="marl-mode-switcher">
              <span class="mode-switcher-label">
                INTERACTIVE SORTIE CONTROL ·{" "}
                <strong data-swarm-count>0 NEUTRALIZED</strong>
              </span>
              <div class="mode-btn-row">
                <button
                  type="button"
                  class="marl-mode-btn active"
                  data-spawn-mosquito-btn
                >
                  ⚡ Spawn Mosquito in Open Window
                </button>
              </div>
            </div>
          </div>

          <p class="blotter-lead">
            To keep the study room serene while illustrating my{" "}
            <strong>multi-agent systems (MARL)</strong> research at RIT’s{" "}
            <strong>KAS Lab</strong>, the lower casement sashes of the study
            window are swung open: whenever an uninvited{" "}
            <strong>mosquito</strong> flies in on a randomized trajectory, the
            windowsill <strong>Radar Sentry</strong> detects it and broadcasts
            target coordinates over a constrained mesh network. Two aerial
            quadrotors (<strong>UAV-α</strong>, <strong>UAV-β</strong>) and a
            ground turret rover (<strong>UGV-γ</strong>) swarm in from off-scene,
            triangulate and neutralize the intruder, and exit cleanly back to
            base.
          </p>

          <div class="marl-agent-cards">
            <div class="marl-agent-card">
              <div class="agent-card-head">
                <span class="agent-id-badge teal">RADAR-01 · WINDOWSILL</span>
                <span class="agent-state-pill">PERIMETER SENTRY</span>
              </div>
              <strong>Detection &amp; Broadcast</strong>
              <p>
                Continuously scans the open casement window, locks onto incoming
                mosquito trajectories, and broadcasts sparse alert packets.
              </p>
            </div>

            <div class="marl-agent-card">
              <div class="agent-card-head">
                <span class="agent-id-badge brass">UAV-α · LEFT INTERCEPT</span>
                <span class="agent-state-pill">AERIAL RECON</span>
              </div>
              <strong>Upper-Left Flank Drone</strong>
              <p>
                Deploys from off-scene upon receiving the sentry broadcast,
                banking into an upper-left triangulation vector.
