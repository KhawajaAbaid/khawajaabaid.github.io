<script>
  const heroRoot = document.querySelector<HTMLElement>("[data-hero-study]");
  if (heroRoot) {
    const tabs = heroRoot.querySelectorAll<HTMLButtonElement>(
      "[data-plaque-tab]",
    );
    const panels = heroRoot.querySelectorAll<HTMLElement>(
      "[data-plaque-panel]",
    );
    const svgHotspots = heroRoot.querySelectorAll<SVGElement>(
      "[data-room-hotspot]",
    );
    const jumpRobotsBtn =
      heroRoot.querySelector<HTMLButtonElement>("[data-jump-robots]");
    const spawnMosquitoBtn = heroRoot.querySelector<HTMLButtonElement>(
      "[data-spawn-mosquito-btn]",
    );
    const swarmLivePhase = heroRoot.querySelector<HTMLElement>(
      "[data-swarm-live-phase]",
    );
    const swarmCountEl =
      heroRoot.querySelector<HTMLElement>("[data-swarm-count]");

    const PHASE_LABELS: Record<string, string> = {
      WAIT: "SENTRY WATCH · WINDOW OPEN",
      FLY_IN: "MOSQUITO ENTERING WINDOW",
      DETECT: "RADAR LOCK & MESH BROADCAST",
      SWARM: "SWARM CONVERGING & LOCKING",
      ZAP: "✦ TARGET NEUTRALIZED!",
      EGRESS: "SWARM RETURNING TO BASE",
    };

    window.addEventListener("study:swarm-state", (e: Event) => {
      const custom = e as CustomEvent<{ phase: string; count: number }>;
      if (swarmLivePhase && custom.detail?.phase) {
        swarmLivePhase.textContent =
          PHASE_LABELS[custom.detail.phase] || custom.detail.phase;
      }
      if (swarmCountEl && typeof custom.detail?.count === "number") {
        swarmCountEl.textContent = `${custom.detail.count} NEUTRALIZED`;
      }
    });

    if (spawnMosquitoBtn) {
      spawnMosquitoBtn.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("study:spawn-mosquito"));
      });
    }

    function activateStudyObject(key: string) {
      tabs.forEach((tab) => {
        const isMatch = tab.dataset.plaqueTab === key;
        tab.classList.toggle("active", isMatch);
        tab.setAttribute("aria-selected", String(isMatch));
      });

      panels.forEach((panel) => {
        const isMatch = panel.dataset.plaquePanel === key;
        panel.classList.toggle("active", isMatch);
        panel.hidden = !isMatch;
      });

      svgHotspots.forEach((spot) => {
        const isMatch = spot.getAttribute("data-room-hotspot") === key;
        spot.classList.toggle("active-hotspot", isMatch);
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        activateStudyObject(tab.dataset.plaqueTab || "identity");
      });
    });

    svgHotspots.forEach((spot) => {
      const key = spot.getAttribute("data-room-hotspot") || "identity";
      spot.addEventListener("click", () => activateStudyObject(key));
      spot.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          activateStudyObject(key);
        }
      });
    });

    if (jumpRobotsBtn) {
      jumpRobotsBtn.addEventListener("click", () => {
        activateStudyObject("robots");
      });
    }

    activateStudyObject("identity");
  }
</script>

