---
import { profile } from "../data/profile";
import StudyRoomScene from "./StudyRoomScene.astro";
---

<section class="study-hero" aria-labelledby="hero-name">
  <!-- Illustrated Study Room & Wall Panorama (Search-and-Rescue Window View, Bookcase, Portraits, Desk & Emeralite Lamp) -->
  <StudyRoomScene />

  <!-- Connected Desk Blotter Console -->
  <div class="desk-blotter-console">
    <div
      class="room-plaque-tabs"
      role="tablist"
      aria-label="Inspect objects in the study room"
    >
      <button
        type="button"
        role="tab"
        id="tab-identity"
        class="plaque-tab"
        aria-selected="true"
        aria-controls="panel-identity"
        tabindex="0"
        data-hotspot-tab="identity"
      >
        <span class="tab-kicker">Desk Nameplate</span>
        <span class="tab-label">{profile.name}</span>
      </button>

      <button
        type="button"
        role="tab"
        id="tab-fulbright"
        class="plaque-tab"
        aria-selected="false"
        aria-controls="panel-fulbright"
        tabindex="-1"
        data-hotspot-tab="fulbright"
      >
        <span class="tab-kicker">Wall Portrait I</span>
        <span class="tab-label">U.S. Fulbright · 4.0 GPA</span>
      </button>

      <button
        type="button"
        role="tab"
        id="tab-aws"
        class="plaque-tab"
        aria-selected="false"
        aria-controls="panel-aws"
        tabindex="-1"
        data-hotspot-tab="aws"
      >
        <span class="tab-kicker">Wall Portrait II</span>
        <span class="tab-label">AWS AI/ML · Return Offer</span>
      </button>

      <button
        type="button"
        role="tab"
        id="tab-kaslab"
        class="plaque-tab"
        aria-selected="false"
        aria-controls="panel-kaslab"
        tabindex="-1"
        data-hotspot-tab="kaslab"
      >
        <span class="tab-kicker">Wall Portrait III</span>
        <span class="tab-label">KAS Lab &amp; Open ML</span>
      </button>
    </div>

    <div class="blotter-panels">
      <!-- Panel 1: Desk Nameplate (Default) -->
      <div
        class="blotter-panel"
        id="panel-identity"
        role="tabpanel"
        aria-labelledby="tab-identity"
        data-hotspot-panel="identity"
      >
        <p class="eyebrow">
          Ph.D. Researcher in ECE · {profile.institution}
        </p>
        <h1 id="hero-name">
          {profile.name}<span class="hero-dot" aria-hidden="true">.</span>
        </h1>
        <p class="blotter-lead">{profile.researchStatement}</p>
        <p class="blotter-secondary">{profile.secondaryBio}</p>
      </div>

      <!-- Panel 2: Wall Portrait I — U.S. Fulbright Scholar -->
      <div
        class="blotter-panel"
        id="panel-fulbright"
        role="tabpanel"
        aria-labelledby="tab-fulbright"
        data-hotspot-panel="fulbright"
        hidden
      >
        <p class="eyebrow">Wall Portrait I · Academic Distinction</p>
        <h2 class="panel-heading">U.S. Fulbright Scholar · 4.0 GPA</h2>
        <p class="blotter-lead">
          Selected through the U.S. Department of State’s flagship international
          academic exchange program to complete my M.S. in Artificial
          Intelligence at Rochester Institute of Technology (4.0 / 4.0 GPA),
          following a 1st-in-class B.S. in Computer Science.
        </p>
        <div class="links panel-links">
          <a href="https://repository.rit.edu/theses/12584/">
            Master’s Thesis (RIT Repository) <span aria-hidden="true">↗</span>
          </a>
          <a href="https://arxiv.org/abs/2607.15467">
            ADS-C Preprint (arXiv) <span aria-hidden="true">↗</span>
          </a>
          <a href="#experience">
            Academic Record <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <!-- Panel 3: Wall Portrait II — Amazon Web Services -->
      <div
        class="blotter-panel"
        id="panel-aws"
        role="tabpanel"
        aria-labelledby="tab-aws"
        data-hotspot-panel="aws"
        hidden
      >
        <p class="eyebrow">Wall Portrait II · Industry Engineering</p>
        <h2 class="panel-heading">Amazon Web Services · AI/ML SDE Intern</h2>
        <p class="blotter-lead">
          Engineered core Apache Spark testing and evaluation modules for a
          next-generation internal benchmarking platform in East Palo Alto
          (Summer 2025), independently delivering benchmarking capabilities
          beyond project scope and earning a full-time return offer.
        </p>
        <div class="links panel-links">
          <a href="/cv.pdf">
            Curriculum Vitae (PDF) <span aria-hidden="true">↗</span>
          </a>
          <a href="#experience">
            Experience Record <span aria-hidden="true">↓</span>
          </a>
          <a href="#projects">
            Projects &amp; Code <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <!-- Panel 4: Wall Portrait III — RIT KAS Lab & Open-Source ML -->
      <div
        class="blotter-panel"
        id="panel-kaslab"
        role="tabpanel"
        aria-labelledby="tab-kaslab"
        data-hotspot-panel="kaslab"
        hidden
      >
        <p class="eyebrow">Wall Portrait III · Research &amp; Open Source</p>
        <h2 class="panel-heading">RIT KAS Lab · Teras &amp; Keras 3</h2>
        <p class="blotter-lead">
          Ph.D. Graduate Research Assistant advised by {profile.advisor},
          researching cooperative search-and-rescue robot teams—including
          constrained communication relays and aerial recharging via
          <em>Fontus</em>—alongside ML security, while creating
          <strong>Teras</strong> and contributing to <strong>Keras 3</strong>.
        </p>
        <div class="links panel-links">
          <a href="#research">
            Research Focus <span aria-hidden="true">↓</span>
          </a>
          <a href="#publications">
            Publications <span aria-hidden="true">↓</span>
          </a>
          <a href="#projects">
            Projects &amp; Code <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>

    <div class="blotter-footer">
      <div class="blotter-actions">
        <a class="btn-primary" href="/cv.pdf">
          Curriculum Vitae (PDF) <span aria-hidden="true">↗</span>
        </a>

        <div class="links blotter-links">
          <a href={profile.links.github}>
            GitHub <span aria-hidden="true">↗</span>
          </a>
          <a href={profile.links.linkedin}>
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
          <a href={profile.links.rit}>
            RIT Profile <span aria-hidden="true">↗</span>
          </a>
          <a href={`mailto:${profile.email}`}>
            Email <span aria-hidden="true">↗</span>
          </a>
          <button
            type="button"
            class="inline-action copy-trigger"
            data-copy={profile.email}
            data-copy-announce="Email address copied to clipboard"
          >
            <span data-copy-label>Copy email</span>
          </button>
        </div>
      </div>

      <button
        type="button"
        class="motion-toggle"
        data-motion-toggle
        aria-pressed="false"
      >
        <span data-motion-label>Pause motion</span>
      </button>
    </div>
  </div>
</section>

<script>
  const heroRoot = document.querySelector<HTMLElement>(".study-hero");
  if (heroRoot) {
    const svgHotspots = heroRoot.querySelectorAll<SVGElement>(
      "[data-room-hotspot]",
    );
    const tabs = Array.from(
      heroRoot.querySelectorAll<HTMLButtonElement>("[data-hotspot-tab]"),
    );
    const panels = heroRoot.querySelectorAll<HTMLElement>(
      "[data-hotspot-panel]",
    );

    function activateHotspot(id: string, focusTab = false) {
      svgHotspots.forEach((el) => {
        el.classList.toggle("active-hotspot", el.dataset.roomHotspot === id);
      });
      tabs.forEach((tab) => {
        const active = tab.dataset.hotspotTab === id;
        tab.setAttribute("aria-selected", active ? "true" : "false");
        tab.tabIndex = active ? 0 : -1;
        if (active && focusTab) tab.focus();
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.hotspotPanel !== id;
      });
    }

    activateHotspot("identity");

    svgHotspots.forEach((hotspot) => {
      hotspot.addEventListener("click", () => {
        const id = hotspot.dataset.roomHotspot;
        if (id) activateHotspot(id);
      });
      hotspot.addEventListener("keydown", (event) => {
        const ke = event as KeyboardEvent;
        if (ke.key === "Enter" || ke.key === " ") {
          ke.preventDefault();
          const id = hotspot.dataset.roomHotspot;
          if (id) activateHotspot(id);
        }
      });
    });

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        const id = tab.dataset.hotspotTab;
        if (id) activateHotspot(id);
      });
      tab.addEventListener("keydown", (event) => {
        let nextIndex = -1;
        if (event.key === "ArrowRight") {
          nextIndex = (index + 1) % tabs.length;
        } else if (event.key === "ArrowLeft") {
          nextIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (event.key === "Home") {
          nextIndex = 0;
        } else if (event.key === "End") {
          nextIndex = tabs.length - 1;
        }
        if (nextIndex >= 0) {
          event.preventDefault();
          const nextId = tabs[nextIndex]?.dataset.hotspotTab;
          if (nextId) activateHotspot(nextId, true);
        }
      });
    });

    const motionBtn = heroRoot.querySelector<HTMLButtonElement>(
      "[data-motion-toggle]",
    );
    const motionLabel = heroRoot.querySelector<HTMLElement>(
      "[data-motion-label]",
    );
    let paused = false;

    motionBtn?.addEventListener("click", () => {
      paused = !paused;
      motionBtn.setAttribute("aria-pressed", paused ? "true" : "false");
      if (motionLabel) {
        motionLabel.textContent = paused ? "Play motion" : "Pause motion";
      }
      window.dispatchEvent(
        new CustomEvent("study:toggle-motion", { detail: { paused } }),
      );
    });
  }
</script>

<style>
  .study-hero {
    padding-block: 1.25rem clamp(2.25rem, 1.6rem + 2vw, 3.25rem);
  }

  .desk-blotter-console {
    background: var(--surface);
    border: 2px solid var(--wood-mid);
    border-block-start: 5px solid #4a3020;
    border-radius: 0 0 8px 8px;
    box-shadow: var(--room-shadow);
    overflow: hidden;
  }

  .room-plaque-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    background: var(--bg-subtle);
    border-block-end: 1px solid var(--border);
  }

  .plaque-tab {
    appearance: none;
    background: transparent;
    border: 0;
    border-inline-end: 1px solid var(--border);
    padding: 0.72rem 1rem;
    text-align: start;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.16rem;
    min-inline-size: 0;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .plaque-tab:last-child {
    border-inline-end: 0;
  }

  .plaque-tab:hover {
    background: color-mix(in srgb, var(--surface) 65%, transparent);
  }

  .plaque-tab[aria-selected="true"] {
    background: var(--surface);
    box-shadow: inset 0 -2px 0 var(--accent-vivid);
  }

  .tab-kicker {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .tab-label {
    font-family: var(--font-display);
    font-size: 0.94rem;
    font-weight: 500;
    color: var(--heading);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .blotter-panels {
    padding: clamp(1.35rem, 1.1rem + 1vw, 1.85rem)
      clamp(1.25rem, 1rem + 1.4vw, 2.1rem);
  }

  .blotter-panel .eyebrow {
    margin-block-end: 0.45rem;
  }

  .hero-dot {
    color: var(--accent-vivid);
  }

  .panel-heading {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .blotter-lead {
    margin-block-start: 0.7rem;
    max-inline-size: 68ch;
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--text);
  }

  .blotter-secondary {
    margin-block-start: 0.6rem;
    max-inline-size: 68ch;
    font-size: 0.92rem;
    line-height: 1.62;
    color: var(--text-muted);
  }

  .panel-links {
    margin-block-start: 0.95rem;
  }

  .blotter-footer {
    padding: 0.9rem clamp(1.25rem, 1rem + 1.4vw, 2.1rem);
    border-block-start: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-subtle) 45%, var(--surface));
    display: flex;
    flex-wrap: wrap;
    align-items: safe center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .blotter-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: safe center;
    gap: 0.65rem 1.35rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-block-size: 2.3rem;
    padding: 0.42rem 0.98rem;
    border-radius: 999px;
    background: var(--pill-bg);
    color: var(--pill-fg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .btn-primary:hover {
    background: var(--pill-hover);
    color: var(--pill-fg);
  }

  .motion-toggle {
    appearance: none;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    min-block-size: 2rem;
    padding: 0.25rem 0.72rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
    cursor: pointer;
    transition:
      border-color 150ms ease,
      color 150ms ease;
  }

  .motion-toggle:hover,
  .motion-toggle[aria-pressed="true"] {
    border-color: var(--border-strong);
    color: var(--heading);
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-toggle {
      display: none;
    }
  }

  @media (pointer: coarse) {
    .plaque-tab,
    .btn-primary,
    .motion-toggle {
      min-block-size: 2.75rem;
    }
  }

  @media (max-width: 56em) {
    .room-plaque-tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .plaque-tab:nth-child(2) {
      border-inline-end: 0;
    }
    .plaque-tab:nth-child(1),
    .plaque-tab:nth-child(2) {
      border-block-end: 1px solid var(--border);
    }
  }

  @media (max-width: 34em) {
    .study-hero {
      padding-block-start: 0.75rem;
    }
    .room-plaque-tabs {
      grid-template-columns: minmax(0, 1fr);
    }
    .plaque-tab {
      border-inline-end: 0;
      border-block-end: 1px solid var(--border);
    }
    .plaque-tab:last-child {
      border-block-end: 0;
    }
  }
</style>
