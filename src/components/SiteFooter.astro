---
import { profile } from "../data/profile";
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="colophon">
      <p class="colophon-title">
        <span class="colophon-ornament" aria-hidden="true">❖</span>
        <span>{profile.name} · © {year}</span>
      </p>
      <p class="colophon-sub">
        {profile.lab} · {profile.institution}
      </p>
    </div>

    <nav aria-label="Footer">
      <a href={`mailto:${profile.email}`}>Email</a>
      <a href="/cv.pdf">CV (PDF)</a>
      <a href={profile.links.github}>GitHub</a>
      <a href={profile.links.linkedin}>LinkedIn</a>
      <a href={profile.links.rit}>RIT Profile</a>
      <a href="#top">Top ↑</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: 2rem;
    border-block-start: 1px solid var(--border);
    padding-block: 2rem 2.75rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: safe center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .colophon-title {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--heading);
  }

  .colophon-ornament {
    color: var(--brass-vivid);
  }

  .colophon-sub {
    margin-block-start: 0.25rem;
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: safe center;
    gap: 0.25rem 1.15rem;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  @media (pointer: coarse) {
    nav a {
      min-block-size: 2.75rem;
    }
  }
</style>
