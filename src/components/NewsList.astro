---
import type { CollectionEntry } from "astro:content";
import { monthYear } from "../lib/content";
interface Props {
  entries: CollectionEntry<"news">[];
}
const { entries } = Astro.props;
---

<ul class="news-list">
  {
    entries.map(({ data }) => (
      <li>
        <>
          <time datetime={data.date.toISOString().slice(0, 10)}>
            {monthYear(data.date)}
          </time>
          <p>{data.href ? <a href={data.href}>{data.text}</a> : data.text}</p>
        </>
      </li>
    ))
  }
</ul>
<style>
  .news-list {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .news-list li {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.5rem;
    padding-block: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }
  .news-list time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    padding-top: 0.2rem;
  }
  .news-list p {
    max-width: none;
  }
  .news-list a {
    text-decoration: none;
  }
  .news-list a:hover {
    text-decoration: underline;
  }
  @media (max-width: 720px) {
    .news-list li {
      grid-template-columns: 80px 1fr;
      gap: 1rem;
      font-size: 0.82rem;
    }
    .news-list time {
      font-size: 0.75rem;
    }
  }
</style>
