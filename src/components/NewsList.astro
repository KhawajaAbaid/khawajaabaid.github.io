---
import type { CollectionEntry } from "astro:content";
import { monthYear } from "../lib/content";

interface Props {
  entries: CollectionEntry<"news">[];
}

const { entries } = Astro.props;
---

<ul class="news-list" role="list">
  {
    entries.map(({ data }) => (
      <li class="news-row">
        <time datetime={data.date.toISOString().slice(0, 10)}>
          {monthYear(data.date)}
        </time>
        <p>{data.href ? <a href={data.href}>{data.text}</a> : data.text}</p>
      </li>
    ))
  }
</ul>

<style>
  .news-list {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .news-row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 0.75rem;
    border-block-start: 1px solid var(--border);
    align-items: baseline;
    font-size: 0.9rem;
  }

  .news-row:first-child {
    padding-block-start: 0;
    border-block-start: 0;
  }

  .news-row:last-child {
    padding-block-end: 0;
  }

  .news-row time {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    color: var(--text-faint);
  }

  .news-row p {
    min-inline-size: 0;
    color: var(--text-muted);
  }

  .news-row a {
    color: var(--text);
  }

  .news-row a:hover {
    color: var(--accent);
  }

  @media (max-width: 36em) {
    .news-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
  }
</style>
