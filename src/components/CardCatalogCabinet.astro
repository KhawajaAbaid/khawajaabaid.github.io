---
import { publicEntries, byDate, byOrder } from "../lib/content";
import { profile } from "../data/profile";
import LinkList from "./LinkList.astro";

const publications = (await publicEntries("publications")).sort(byDate);
const allProjects = (await publicEntries("projects")).sort(byOrder);
const engineeringAndSystems = allProjects.filter(
  (p) => p.data.category !== "archive",
);
const archiveProjects = allProjects.filter(
  (p) => p.data.category === "archive",
);

const projectSpecs: Record<string, { badge: string; callNo: string }> = {
  teras: {
    callNo: "DESK FOLIO // TERAS",
    badge: "JAX · PyTorch · TensorFlow (Keras 3)",
  },
  keras: {
    callNo: "DESK FOLIO // KERAS 3",
    badge: "Official Keras 3 · Beta & Binomial Sampling",
  },
  codriver: {
    callNo: "DESK FOLIO // CODRIVER",
    badge: "Flax Linen → NNX · Gemma 2 · 8× H100 GPUs",
  },
  "micrograd-c": {
    callNo: "DESK FOLIO // MICROGRAD-C",
    badge: "Pure C · Reverse-Mode Scalar Autograd",
  },
  "ads-c": {
    callNo: "DESK FOLIO // ADS-C",
    badge: "PyTorch Harness · CIFAR-10 / 100 / Tiny-ImageNet",
  },
  fontus: {
    callNo: "DESK FOLIO // FONTUS",
    badge: "PettingZoo Parallel · Ray RLlib · IPPO/PPO",
  },
};
---

<div class="mahogany-writing-bureau" data-catalog-cabinet>
  <!-- Top Carved Mahogany Desk Bureau & Brass Bail Drawer Handles -->
  <div class="bureau-crown">
    <div class="crown-title-row">
      <div>
        <p class="eyebrow">MAHOGANY WRITING BUREAU // DESK DRAWERS I — IV</p>
        <h2>Manuscripts, Open-Source Libraries &amp; Study Apparatus</h2>
      </div>
      <div class="cabinet-links">
        <a href="/publications/">All Manuscripts →</a>
        <a href="/projects/">All Apparatus →</a>
      </div>
    </div>

    <!-- Physical-style Walnut Desk Drawers with Brass Label Plates -->
    <div
      class="drawer-pulls"
      role="tablist"
      aria-label="Study Desk Drawers"
    >
      <button
        type="button"
        role="tab"
        aria-selected="true"
        data-drawer-filter="featured"
        class="drawer-pull active"
      >
        <span class="brass-frame">
          <span class="drawer-code">DESK DRAWER I</span>
          <span class="drawer-name">Selected Highlights (6)</span>
        </span>
        <span class="brass-bail" aria-hidden="true"></span>
      </button>

      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-drawer-filter="papers"
        class="drawer-pull"
      >
        <span class="brass-frame">
          <span class="drawer-code">DESK DRAWER II</span>
          <span class="drawer-name">
            Papers &amp; Preprints ({publications.length})
          </span>
        </span>
        <span class="brass-bail" aria-hidden="true"></span>
      </button>

      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-drawer-filter="systems"
        class="drawer-pull"
      >
        <span class="brass-frame">
          <span class="drawer-code">DESK DRAWER III</span>
          <span class="drawer-name">
            Open-Source &amp; Research Code ({engineeringAndSystems.length})
          </span>
        </span>
        <span class="brass-bail" aria-hidden="true"></span>
      </button>

      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-drawer-filter="archive"
        class="drawer-pull"
      >
        <span class="brass-frame">
          <span class="drawer-code">DESK DRAWER IV</span>
          <span class="drawer-name">
            Earlier Study Archive ({archiveProjects.length})
          </span>
        </span>
        <span class="brass-bail" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- Velvet-Lined Study Bureau Tray Holding Clean Monograph Folios -->
  <div class="bureau-tray">
    <div class="cards-grid">
      {/* PAPERS & PREPRINTS FOLIOS */}
      {
        publications.map((pub, idx) => (
          <article
            class="study-panel desk-folio-card"
            data-card-drawer="papers"
            data-card-featured="true"
          >
            <div class="slip-top-bar">
              <span class="slip-call">
                MANUSCRIPT 0{idx + 1} // {pub.data.venue}
              </span>
              <span class="brass-tag">{pub.data.status}</span>
            </div>

            <h3 class="slip-title">{pub.data.title}</h3>

            <p class="slip-authors">
              {pub.data.authors.map((author, i) => (
                <>
                  {i > 0 && ", "}
                  {author === profile.name ? <strong>{author}</strong> : author}
                </>
              ))}
            </p>

            {pub.data.metric && (
              <div class="slip-metric">
                <span class="metric-num">{pub.data.metric.value}</span>
                <div class="metric-text">
                  <strong>{pub.data.metric.label}</strong>
                  {pub.data.metric.context && (
                    <span>{pub.data.metric.context}</span>
                  )}
                </div>
              </div>
            )}

            <p class="slip-summary">{pub.data.summary}</p>

            <div class="slip-bottom">
              <LinkList links={pub.data.links} context={pub.data.title} />
              {pub.data.bibtex && (
                <details class="mini-bibtex">
                  <summary>
                    BibTeX Citation<span class="sr-only"> for {pub.data.title}</span>
                  </summary>
                  <pre><code>{pub.data.bibtex}</code></pre>
                </details>
              )}
            </div>
          </article>
        ))
      }

      {/* OPEN-SOURCE & RESEARCH SYSTEMS FOLIOS */}
      {
        engineeringAndSystems.map((proj) => {
          const spec = projectSpecs[proj.id] ?? {
            callNo: `DESK FOLIO // ${proj.id.toUpperCase()}`,
            badge: proj.data.category,
          };
          const isFeatured = ["teras", "keras", "fontus"].includes(proj.id);
          return (
            <article
              class="study-panel desk-folio-card"
              data-card-drawer="systems"
              data-card-featured={isFeatured ? "true" : "false"}
            >
              <div class="slip-top-bar">
                <span class="slip-call">{spec.callNo}</span>
                <span class="brass-tag teal">{spec.badge}</span>
              </div>

              <h3 class="slip-title">{proj.data.title}</h3>

              <p class="slip-summary">{proj.data.summary}</p>

              <div class="slip-tags">
                {proj.data.tags.map((tag) => (
                  <span class="tag-chip">{tag}</span>
                ))}
              </div>

              {proj.data.links.length > 0 && (
                <div class="slip-bottom">
                  <LinkList links={proj.data.links} context={proj.data.title} />
                </div>
              )}
            </article>
          );
        })
      }

      {/* EARLY ARCHIVE FOLIOS */}
      {
        archiveProjects.map((item, idx) => (
          <article
            class="study-panel desk-folio-card archive-slip"
            data-card-drawer="archive"
            data-card-featured="false"
            hidden
          >
            <div class="slip-top-bar">
              <span class="slip-call">
                ARCHIVE 0{idx + 1} // EARLY STUDY WORK
              </span>
              <span class="brass-tag">2021 — 2023</span>
            </div>

            <h3 class="slip-title">{item.data.title}</h3>
            <p class="slip-summary">{item.data.summary}</p>

            {item.data.links.length > 0 && (
              <div class="slip-bottom">
                <LinkList links={item.data.links} context={item.data.title} />
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</div>

<script>
  const cabinets = document.querySelectorAll<HTMLElement>(
    "[data-catalog-cabinet]",
  );
  cabinets.forEach((cabinet) => {
    const pulls = cabinet.querySelectorAll<HTMLButtonElement>(
      "[data-drawer-filter]",
    );
    const cards = cabinet.querySelectorAll<HTMLElement>("[data-card-drawer]");

    function selectDrawer(mode: string) {
      pulls.forEach((btn) => {
        const active = btn.dataset.drawerFilter === mode;
        btn.classList.toggle("active", active);
        btn.setAttribute("aria-selected", String(active));
      });

      cards.forEach((card) => {
        const drawer = card.dataset.cardDrawer;
        const featured = card.dataset.cardFeatured === "true";
        const show = mode === "featured" ? featured : drawer === mode;
        card.hidden = !show;
      });
    }

    selectDrawer("featured");
    pulls.forEach((btn) => {
      btn.addEventListener("click", () => {
        selectDrawer(btn.dataset.drawerFilter || "featured");
      });
    });
  });
</script>

<style>
  .mahogany-writing-bureau {
    border: 2px solid var(--wood-mid);
    border-radius: 8px;
    background: var(--bg-recessed);
    box-shadow: var(--card-shadow);
    overflow: hidden;
  }

  .bureau-crown {
    padding: 1.65rem 2rem 1.4rem;
    background:
      radial-gradient(
        ellipse 60% 60% at 50% 0%,
        rgba(242, 204, 143, 0.16),
        transparent 75%
      ),
      var(--surface);
    border-bottom: 4px solid #4a3020;
  }

  .crown-title-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem 2rem;
    margin-bottom: 1.35rem;
  }

  .crown-title-row .eyebrow {
    margin-bottom: 0.4rem;
  }

  .cabinet-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .cabinet-links a {
    font-family: var(--font-mono);
    font-size: 0.73rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.42rem 0.8rem;
    background: var(--bg);
    border: 1px solid var(--brass);
    border-radius: 4px;
    text-decoration: none;
  }

  .cabinet-links a:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  /* Walnut Desk Drawer Pulls Grid */
  .drawer-pulls {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
  }

  .drawer-pull {
    background: linear-gradient(180deg, #593a27 0%, #3b2518 100%);
    border: 1.5px solid #241710;
    border-radius: 5px;
    padding: 0.65rem 0.75rem 0.55rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      0 3px 6px rgba(0, 0, 0, 0.2);
    transition:
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 200ms ease;
  }

  .drawer-pull:hover,
  .drawer-pull.active {
    background: linear-gradient(180deg, #6e4830 0%, #4a3020 100%);
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      0 8px 16px rgba(0, 0, 0, 0.28);
  }

  .drawer-pull.active {
    outline: 2px solid var(--brass);
    outline-offset: 2px;
  }

  .brass-frame {
    width: 100%;
    background: #faf8ef;
    color: #232536;
    border: 2px solid #c49240;
    border-radius: 2px;
    padding: 0.32rem 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .drawer-code {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #9c6220;
  }

  .drawer-name {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    color: #232536;
    margin-top: 0.08rem;
  }

  .brass-bail {
    width: 28px;
    height: 7px;
    border-radius: 0 0 8px 8px;
    border: 2px solid #e5b968;
    border-top: 0;
  }

  /* Recessed Bureau Tray Containing Clean Study Folios */
  .bureau-tray {
    padding: 1.85rem 2rem;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.35rem;
  }

  .desk-folio-card {
    padding: 1.25rem 1.65rem 1.5rem;
    display: flex;
    flex-direction: column;
    animation: cardSlideUp 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes cardSlideUp {
    from {
      opacity: 0.5;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .slip-top-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.65rem;
    margin-bottom: 0.8rem;
    border-bottom: 1px solid var(--border);
  }

  .slip-call {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    color: var(--heading);
  }

  .slip-title {
    font-size: 1.35rem;
    line-height: 1.26;
    color: var(--heading);
  }

  .slip-authors {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.45rem;
  }

  .slip-authors strong {
    color: var(--text);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--brass);
    text-underline-offset: 3px;
  }

  .slip-metric {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.8rem;
    padding: 0.55rem 0.85rem;
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-left: 3px solid var(--brass);
    border-radius: 4px;
  }

  .metric-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--heading);
    white-space: nowrap;
  }

  .metric-text {
    display: flex;
    flex-direction: column;
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .metric-text strong {
    color: var(--heading);
  }

  .metric-text span {
    color: var(--text-muted);
  }

  .slip-summary {
    font-size: 0.88rem;
    line-height: 1.58;
    color: var(--text-muted);
    margin-top: 0.75rem;
  }

  .slip-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.8rem;
  }

  .tag-chip {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    padding: 0.15rem 0.48rem;
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    color: var(--text-muted);
  }

  .slip-bottom {
    margin-top: auto;
    padding-top: 0.85rem;
  }

  .mini-bibtex {
    margin-top: 0.35rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 980px) {
    .drawer-pulls {
      grid-template-columns: repeat(2, 1fr);
    }
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .bureau-crown,
    .bureau-tray {
      padding: 1.25rem;
    }
    .drawer-pulls {
      grid-template-columns: 1fr;
    }
    .desk-folio-card {
      padding-inline: 1.15rem;
    }
    .slip-metric {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>
