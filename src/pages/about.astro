---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CareerLedger from "../components/CareerLedger.astro";
import { profile } from "../data/profile";
---

<BaseLayout
  title="Experience & CV"
  description="Experience and education of Khawaja Abaid Ullah: ECE PhD student and Graduate Research Assistant at RIT’s KAS Lab, MS in AI (May 2026, Fulbright Scholarship, 4.0 GPA), AWS SDE internship, Teras and Keras contributions."
>
  <header class="page-intro">
    <p class="eyebrow">Curriculum Vitae &amp; Dossier</p>
    <h1>{profile.name} — Research &amp; Engineering Record</h1>
    <p>
      First-year PhD student in Electrical &amp; Computer Engineering and Graduate
      Research Assistant at RIT’s Khojasteh Autonomous Systems Laboratory, advised
      by {profile.advisor}. I started in June 2026 and expect to graduate in May
      2029. Previously, I completed an MS in AI at RIT as a Fulbright Scholar,
      interned as an SDE at AWS, and built independent ML software, including Teras
      and merged Keras contributions.
    </p>
  </header>

  <section class="monograph-section">
    <div class="monograph-grid">
      <SectionHeader
        eyebrow="01 / Highlights"
        title="Fellowship & Industry"
        href="/cv.pdf"
        linkLabel="Download CV (PDF)"
      />
      <div class="monograph-body">
        <div class="highlights-pair">
          <article class="dossier-highlight warm">
            <p class="highlight-kicker">
              U.S. Department of State · Aug 2024 – May 2026
            </p>
            <h3>U.S. Fulbright Scholar — M.S. in AI at RIT (4.0 / 4.0 GPA)</h3>
            <p>
              Completed my M.S. in Artificial Intelligence at Rochester Institute
              of Technology in May 2026 with a 4.0/4.0 GPA, supported by the U.S.
              Department of State Fulbright Scholarship. My thesis was
              “Antidistillation Sampling for Classification.” I began my PhD at
              KAS Lab in June 2026 with a fully funded graduate research
              assistantship.
            </p>
            <div class="links">
              <a href="https://repository.rit.edu/theses/12584/">
                Master’s Thesis (RIT Repository){" "}
                <span aria-hidden="true">↗</span>
              </a>
              <a href="https://arxiv.org/abs/2607.15467">
                ADS-C Preprint (arXiv) <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>

          <article class="dossier-highlight teal">
            <p class="highlight-kicker">
              East Palo Alto, CA · May 2025 – Aug 2025 · Full-Time Return Offer
            </p>
            <h3>Software Development Engineer Intern, AI/ML — AWS</h3>
            <p>
              Engineered core Apache Spark testing and evaluation modules for an
              internal benchmarking platform at Amazon Web
              Services, closing feature-parity gaps with its legacy predecessor
              and independently delivering additional benchmarking capabilities
              that earned a full-time return offer.
            </p>
            <div class="links">
              <a href="/projects/">
                Open-Source ML Engineering <span aria-hidden="true">→</span>
              </a>
              <a href="/cv.pdf">
                Full Resume / CV (PDF) <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="monograph-section">
    <div class="monograph-grid">
      <SectionHeader
        eyebrow="02 / Chronology"
        title="Full Record & Stack"
        description="Appointments, degrees, teaching, academic service, and technical stack."
      />
      <div class="monograph-body">
        <CareerLedger />
      </div>
    </div>
  </section>

  <div class="contact-strip">
    <p>
      Available for research collaboration in multi-agent coordination, ML security,
      and open-source ML systems.
    </p>
    <div class="links">
      <a href={`mailto:${profile.email}`}>
        {profile.email} <span aria-hidden="true">↗</span>
      </a>
      <a href="/cv.pdf">
        CV (PDF) <span aria-hidden="true">↗</span>
      </a>
      <a href={profile.links.github}>
        GitHub <span aria-hidden="true">↗</span>
      </a>
      <a href={profile.links.linkedin}>
        LinkedIn <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .highlights-pair {
    display: grid;
    gap: 1.75rem;
  }

  .dossier-highlight {
    padding-inline-start: 1.15rem;
    border-inline-start: 2px solid var(--border-strong);
  }

  .dossier-highlight.warm {
    border-inline-start-color: var(--brass-vivid);
  }

  .dossier-highlight.teal {
    border-inline-start-color: var(--teal-vivid);
  }

  .highlight-kicker {
    font-family: var(--font-mono);
    font-size: 0.71rem;
    color: var(--brass);
    margin-block-end: 0.25rem;
  }

  .dossier-highlight p:not(.highlight-kicker) {
    margin-block-start: 0.45rem;
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .dossier-highlight .links {
    margin-block-start: 0.55rem;
  }
</style>
