---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import PublicationItem from "../../components/PublicationItem.astro";
import LinkList from "../../components/LinkList.astro";
import { publicEntries, byOrder } from "../../lib/content";
import { directions, profile } from "../../data/profile";

const researchEntries = (await publicEntries("research")).sort(byOrder);
const publications = (await publicEntries("publications")).sort(byOrder);
---

<BaseLayout
  title="Research"
  description="Multi-agent coordination, decentralized task allocation and LLM-assisted planning at RIT’s KAS Lab, with emerging interests in LLM-guided algorithm discovery and prior contributions to antidistillation and LLM evaluation."
>
  <header class="page-intro">
    <p class="eyebrow">KAS Lab · Rochester Institute of Technology</p>
    <h1>How autonomous teams coordinate</h1>
    <p>
      I study multi-agent coordination and decision-making as a PhD student and
      Graduate Research Assistant, advised by {profile.advisor}.
    </p>
  </header>
  <section class="monograph-section">
    <div class="monograph-grid">
      <SectionHeader
        eyebrow="01 / Questions"
        title="Current research & future directions"
        description="The questions I work on now, and the directions I hope to explore."
      />
      <div class="monograph-body">
        <ol class="agenda-list" role="list">
          {directions.map((d) => (
            <li id={d.id} class:list={["agenda-item", d.accent]}>
              <p class="agenda-status">{d.status}</p>
              <h3>{d.title}</h3>
              <p class="agenda-question">{d.question}</p>
              <p class="agenda-summary">{d.summary}</p>
              {d.links.length > 0 && (
                <div class="highlight-links">
                  <LinkList links={d.links} context={d.title} />
                </div>
              )}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
  <section class="monograph-section">
    <div class="monograph-grid">
      <SectionHeader
        eyebrow="02 / Contributions"
        title="Papers & other research contributions"
        description="Coordination work alongside classification defenses, knowledge distillation and collaborative LLM evaluation."
        href="/publications/"
        linkLabel="All papers & preprints"
      />
      <div class="monograph-body">
        <p class="contribution-intro">
          Beyond my current coordination agenda, my work includes ADS-C, the
          AntidistillBench manuscript, compact-model knowledge distillation in{" "}
          <a href="/projects/#codriver">codriver</a>, and collaborative
          evaluation of LLM judgments against human ratings.
        </p>
        {publications.map((entry) => (
          <PublicationItem entry={entry} />
        ))}
      </div>
    </div>
  </section>
  <section class="monograph-section">
    <div class="monograph-grid">
      <SectionHeader
        eyebrow="03 / Projects"
        title="Selected research & course projects"
        description="Implementation details, experimental scope, and lessons from simulation."
      />
      <div class="monograph-body">
        <div class="highlights-stack">
          {researchEntries.map(({ data, id }) => (
            <article class="highlight-entry" id={`system-${id}`}>
              <p class="highlight-cat">
                {data.category} · {data.status}
              </p>
              <h3>
                <a href={`/research/${id}/`}>{data.shortTitle ?? data.title}</a>
              </h3>
              <p class="highlight-summary">{data.summary}</p>
              <div class="highlight-links">
                <a href={`/research/${id}/`}>Project details →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
  <div class="contact-strip">
    <p>Interested in autonomous-team coordination or ML software?</p>
    <div class="links">
      <a href={`mailto:${profile.email}`}>{profile.email} ↗</a>
      <a href="/cv.pdf">CV (PDF) ↗</a>
    </div>
  </div>
</BaseLayout>

<style>
  .contribution-intro {
    margin-block-end: 1.5rem;
    color: var(--text-muted);
  }

  .agenda-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 2rem;
  }

  .agenda-item {
    padding-inline-start: 1.15rem;
    border-inline-start: 2px solid var(--border-strong);
  }

  .agenda-item.teal {
    border-inline-start-color: var(--teal-vivid);
  }

  .agenda-item.peach {
    border-inline-start-color: var(--accent-vivid);
  }

  .agenda-item.brass {
    border-inline-start-color: var(--brass-vivid);
  }

  .agenda-status,
  .highlight-cat {
    font-family: var(--font-mono);
    font-size: 0.71rem;
    color: var(--brass);
    margin-block-end: 0.25rem;
  }

  .agenda-question {
    margin-block-start: 0.35rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--heading);
  }

  .agenda-summary,
  .highlight-summary {
    margin-block-start: 0.45rem;
    font-size: 0.93rem;
    color: var(--text-muted);
  }

  .agenda-foot {
    margin-block-start: 0.65rem;
    display: flex;
    flex-wrap: wrap;
    align-items: safe center;
    justify-content: space-between;
    gap: 0.35rem 1.25rem;
  }

  .highlights-stack {
    display: grid;
    gap: 1.5rem;
  }

  .highlight-entry + .highlight-entry {
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--border);
  }

  .highlight-links {
    margin-block-start: 0.55rem;
  }
</style>
