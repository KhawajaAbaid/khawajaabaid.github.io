---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import PublicationItem from "../components/PublicationItem.astro";
import { publicEntries, byOrder } from "../lib/content";

const publications = (await publicEntries("publications")).sort(byOrder);
---

<BaseLayout
  title="Publications"
  description="Papers and preprints by Khawaja Abaid Ullah on margin-aware antidistillation defenses against model extraction (ADS-C, matched-cost review) and large-scale human-LLM alignment."
>
  <header class="page-intro">
    <p class="eyebrow">Papers &amp; Preprints</p>
    <h1>Selected Manuscripts</h1>
    <p>
      Concise summaries of first-author and collaborative research on
      inference-time antidistillation defenses against model extraction and
      theory-grounded evaluation across 34 LLMs and 198 human participants, with
      direct links to arXiv, PDFs, and open-source code.
    </p>
  </header>

  <section class="monograph-section">
    <div class="monograph-grid">
      <SectionHeader
        eyebrow="2026"
        title="Preprints & Reviews"
        description="Click any paper title or arXiv link for the full manuscript and experimental plots."
      />
      <div class="monograph-body">
        {publications.map((entry) => <PublicationItem entry={entry} />)}
      </div>
    </div>
  </section>
</BaseLayout>
