---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import PublicationItem from "../components/PublicationItem.astro";
import { publicEntries, byOrder } from "../lib/content";

const publications = (await publicEntries("publications")).sort(byOrder);
---

<BaseLayout
  title="Publications"
  description="Papers and preprints by Khawaja Abaid Ullah on multi-agent coordination, decentralized LLM planning, antidistillation defenses, benchmark evaluation and LLM judgments."
>
  <header class="page-intro">
    <p class="eyebrow">Papers &amp; Preprints</p>
    <h1>Selected Papers and Preprints</h1>
    <p>
      Research on multi-agent coordination and decentralized LLM planning,
      classification defenses and their evaluation, and collaborative comparison
      of LLM judgments with human ratings. Each entry distinguishes preprint
      availability from review status.
    </p>
  </header>

  <section class="monograph-section">
    <div class="monograph-grid">
      <SectionHeader
        eyebrow="2026"
        title="Papers & Manuscripts"
        description="Public manuscripts link to arXiv and code. AntidistillBench is under review; no public manuscript or benchmark release is linked."
      />
      <div class="monograph-body">
        {publications.map((entry) => (
          <PublicationItem entry={entry} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
