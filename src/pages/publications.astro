---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationItem from "../components/PublicationItem.astro";
import { publicEntries, byDate } from "../lib/content";
const publications = (await publicEntries("publications")).sort(byDate);
---

<BaseLayout
  title="Publications"
  description="Papers and preprints by Khawaja Abaid Ullah on test-time antidistillation defenses (ADS-C, matched-cost review) and large-scale human-LLM social judgment alignment."
>
  <header class="page-intro">
    <p class="eyebrow">THE STUDY READING TABLE // PAPERS &amp; PREPRINTS</p>
    <h1>Selected Manuscripts &amp; Preprints</h1>
    <p>
      Research manuscripts on margin-aware inference-time antidistillation
      defenses against model extraction (ADS-C and matched-cost benchmark review)
      and theory-grounded evaluation across 34 LLMs and 198 human participants.
    </p>
  </header>
  <div class="publication-index">
    {
      publications.map((entry) => (
        <PublicationItem entry={entry} headingLevel="h2" />
      ))
    }
  </div>
</BaseLayout>

<style>
  .publication-index {
    padding-bottom: 5rem;
  }
</style>
