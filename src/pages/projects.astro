---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { publicEntries, byOrder } from "../lib/content";
const projects = (await publicEntries("projects")).sort(byOrder);
const systems = projects.filter((p) => p.data.category === "research-system");
const engineering = projects.filter((p) => p.data.category === "engineering");
const archive = projects.filter((p) => p.data.category === "archive");
---

<BaseLayout
  title="Projects"
  description="Open-source machine learning libraries and research systems by Khawaja Abaid Ullah: Teras (Keras 3 tabular DL), official Keras 3 random-sampling APIs, codriver (260M Gemma 2 Flax NNX), micrograd_c, ADS-C, and Fontus."
>
  <header class="page-intro">
    <p class="eyebrow">THE MAHOGANY WRITING BUREAU // OPEN-SOURCE &amp; RESEARCH CODE</p>
    <h1>Open-Source Libraries, Distilled Models &amp; Multi-Agent Systems</h1>
    <p>
      From creating <strong>Teras</strong> (multi-backend tabular deep learning
      across JAX, PyTorch, and TensorFlow) and contributing random-sampling APIs
      to official <strong>Keras 3</strong>, to porting <strong>Gemma 2</strong>
      from Flax Linen to NNX for staged distillation (<strong>codriver</strong>)
      and writing an autograd engine from scratch in <strong>pure C</strong> (<strong>micrograd_c</strong>).
    </p>
  </header>

  {
    engineering.length > 0 && (
      <section class="section" aria-label="Open-source ML and systems">
        <SectionHeader
          eyebrow="BUREAU DRAWER I // OPEN-SOURCE LIBRARIES &amp; DISTILLED MODELS"
          title="Multi-Backend ML Infrastructure &amp; Engines"
          description="Production-grade open-source libraries, official framework contributions, and low-level neural network implementations."
        />
        {engineering.map((entry) => (
          <ProjectRow entry={entry} />
        ))}
      </section>
    )
  }

  {
    systems.length > 0 && (
      <section class="section" aria-label="Research systems">
        <SectionHeader
          eyebrow="BUREAU DRAWER II // RESEARCH ENVIRONMENTS &amp; HARNESSES"
          title="Multi-Agent RL &amp; Antidistillation Codebases"
          description="Open-source PyTorch evaluation harnesses and PettingZoo Parallel / Ray RLlib multi-agent simulation environments."
        />
        {systems.map((entry) => (
          <ProjectRow entry={entry} />
        ))}
      </section>
    )
  }

  {
    archive.length > 0 && (
      <section class="section" aria-label="Earlier projects">
        <SectionHeader
          eyebrow="BUREAU DRAWER III // UNDERGRADUATE &amp; EARLY ARCHIVE"
          title="Earlier Student &amp; Personal Projects"
          description="Early work in computer vision, scikit-learn forecasting, Harvard CS50x, and NLP bots (2021–2023)."
        />
        <ul class="archive">
          {archive.map(({ data }) => (
            <li>
              <strong>{data.title}</strong> — {data.summary}
              {data.links.map((link) => (
                <>
                  {" "}
                  <a
                    href={link.href}
                    aria-label={`${link.label} — ${data.title}`}
                  >
                    {link.label} ↗
                  </a>
                </>
              ))}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
