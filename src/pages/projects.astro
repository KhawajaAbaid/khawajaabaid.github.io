---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { publicEntries, byOrder } from "../lib/content";

const projects = (await publicEntries("projects")).sort(byOrder);
const featured = projects.filter((p) => p.data.category !== "archive");
const archive = projects.filter((p) => p.data.category === "archive");
---

<BaseLayout
  title="Projects"
  description="ML software and research implementations by Khawaja Abaid Ullah: decentralized LLM coordination testbed, Teras, merged Keras contributions, ADS-C, codriver and the Fontus simulation project."
>
  <header class="page-intro">
    <p class="eyebrow">Research &amp; software</p>
    <h1>Coordination testbeds &amp; ML engineering</h1>
    <p>
      I build research implementations and machine-learning software, from
      decentralized LLM teams and a multi-backend tabular library to upstream
      samplers and compact code-generation models. Independent open-source
      contributions, research implementations and dated course projects are
      labelled below.
    </p>
  </header>
  <section class="monograph-section">
    <div class="monograph-grid">
      <SectionHeader
        eyebrow="01 / Selected work"
        title="Projects & Code"
        description="Current coordination research, independent ML software, and earlier research and course projects."
      />
      <div class="monograph-body">
        {featured.map((entry) => (
          <ProjectRow entry={entry} />
        ))}
      </div>
    </div>
  </section>

  {archive.length > 0 && (
    <section class="monograph-section">
      <div class="monograph-grid">
        <SectionHeader
          eyebrow="02 / Archive"
          title="Earlier Work"
          description="Student and personal projects in computer vision, forecasting, and NLP (2021–2023)."
        />
        <div class="monograph-body">
          <details>
            <summary>
              Earlier student &amp; personal projects ({archive.length})
            </summary>
            <ul class="archive-list" role="list">
              {archive.map(({ data }) => (
                <li>
                  <strong>{data.title}</strong> — {data.summary}
                  {data.links.map((link) => (
                    <>
                      {" "}
                      <a
                        href={link.href}
                        aria-label={`${link.label} — ${data.title}`}
                      >
                        {link.label} <span aria-hidden="true">↗</span>
                      </a>
                    </>
                  ))}
                </li>
              ))}
            </ul>
          </details>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .archive-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 0.75rem;
  }

  .archive-list li {
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--border);
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .archive-list li:last-child {
    padding-block-end: 0;
    border-block-end: 0;
  }

  .archive-list strong {
    color: var(--heading);
    font-weight: 500;
  }

  .archive-list a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--heading);
  }
</style>
