---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import DirectionsShelf from "../components/DirectionsShelf.astro";
import CardCatalogCabinet from "../components/CardCatalogCabinet.astro";
import FeaturedResearch from "../components/FeaturedResearch.astro";
import NewsList from "../components/NewsList.astro";
import { publicEntries, byDate, byOrder } from "../lib/content";

const research = (await publicEntries("research"))
  .filter((e) => e.data.selected)
  .sort(byOrder);
const news = (await publicEntries("news")).sort(byDate).slice(0, 5);
---

<BaseLayout>
  <Hero />

  <section class="section" aria-label="The Study Bookshelf and Research Lectern">
    <SectionHeader
      eyebrow="STATION I // THE MAHOGANY BOOKSHELF &amp; BLUEPRINT LECTERN"
      title="Research Domains at RIT’s KAS Lab"
      description="Hover or select a clothbound volume on the study shelf to illuminate its schematic blueprint and empirical findings on the reading lectern."
      href="/research/"
      linkLabel="Enter Research Wing"
    />
    <DirectionsShelf />
  </section>

  {
    research.length > 0 && (
      <section class="section" aria-label="Framed Study Wall Plates">
        <SectionHeader
          eyebrow="STATION II // FRAMED STUDY WALL PLATES"
          title="Flagship Technical Case Studies"
          description="Detailed formulations and experimental evaluations for ADS-C (arXiv:2607.15467) and Fontus (Multi-Agent UAV Recharging in PettingZoo &amp; Ray RLlib)."
          href="/research/"
          linkLabel="All Research Plates"
        />
        {research.map((entry, i) => (
          <FeaturedResearch entry={entry} reverse={i % 2 === 1} />
        ))}
      </section>
    )
  }

  <section class="section" aria-label="Mahogany Writing Bureau Drawers">
    <CardCatalogCabinet />
  </section>

  {
    news.length > 0 && (
      <section class="section" aria-label="Study Mantelpiece Dispatches">
        <SectionHeader
          eyebrow="STATION III // STUDY MANTELPIECE CHRONICLE"
          title="Recent Milestones &amp; Dispatches"
          description="Chronological log across RIT’s KAS Lab, Amazon Web Services (East Palo Alto), and the U.S. Fulbright Program."
          href="/about/"
          linkLabel="Open Full CV &amp; Dossier"
        />
        <NewsList entries={news} />
      </section>
    )
  }
</BaseLayout>
