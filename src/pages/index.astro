---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import DirectionsShelf from "../components/DirectionsShelf.astro";
import PublicationItem from "../components/PublicationItem.astro";
import ProjectRow from "../components/ProjectRow.astro";
import CareerLedger from "../components/CareerLedger.astro";
import NewsList from "../components/NewsList.astro";
import { publicEntries, byDate, byOrder } from "../lib/content";

const publications = (await publicEntries("publications"))
  .sort(byOrder)
  .slice(0, 3);
const allProjects = (await publicEntries("projects")).sort(byOrder);
const selectedProjects = allProjects.filter((p) => p.data.selected);
const archiveProjects = allProjects.filter(
  (p) => p.data.category === "archive",
);
const news = (await publicEntries("news")).sort(byDate).slice(0, 5);
---

<BaseLayout>
  <Hero />

  <section id="research" class="monograph-section">
    <div class="monograph-grid">
      <SectionHeader
        eyebrow="01 / Research"
        title="Research Focus"
        description="Decentralized coordination today; algorithm discovery as an emerging direction."
        href="/research/"
        linkLabel="Research overview"
      />
      <div class="monograph-body">
        <DirectionsShelf />
      </div>
    </div>
  </section>

  <section id="publications" class="monograph-section">
    <div class="monograph-grid">
      <SectionHeader
        eyebrow="02 / Papers"
        title="Selected Papers and Preprints"
        description="Current coordination research and contributions to classification defenses."
        href="/publications/"
        linkLabel="All papers & collaborative work"
      />
      <div class="monograph-body">
        {publications.map((entry) => (
          <PublicationItem entry={entry} />
        ))}
      </div>
    </div>
  </section>

  <section id="projects" class="monograph-section">
    <div class="monograph-grid">
      <SectionHeader
        eyebrow="03 / Projects"
        title="Projects & Code"
        description="A coordination testbed, a multi-backend ML library, merged upstream contributions, and defense code."
        href="/projects/"
        linkLabel="All projects"
      />
      <div class="monograph-body">
        <div>
          {selectedProjects.map((entry) => (
            <ProjectRow entry={entry} idPrefix="project-" />
          ))}
        </div>
        {
          archiveProjects.length > 0 && (
            <details class="archive-disclosure">
              <summary>
                Earlier student &amp; personal projects ({archiveProjects.length})
              </summary>
              <ul class="archive-compact" role="list">
                {archiveProjects.map(({ data }) => (
                  <li>
                    <strong>{data.title}</strong> — {data.summary}
                    {data.links.map((link) => (
                      <>
                        {" "}
                        <a
                          href={link.href}
                          aria-label={`${link.label} — ${data.title}`}
                        >
                          {link.label} <span aria-hidden="true">↗</span>
                        </a>
                      </>
                    ))}
                  </li>
                ))}
              </ul>
            </details>
          )
        }
      </div>
    </div>
  </section>

  <section id="experience" class="monograph-section">
    <div class="monograph-grid">
      <SectionHeader
        eyebrow="04 / Record"
        title="Experience & CV"
        description="Research, industry, teaching, academic service, and education."
        href="/about/"
        linkLabel="Full experience & education"
      />
      <div class="monograph-body">
        <CareerLedger />
      </div>
    </div>
  </section>

  {news.length > 0 && (
    <section id="notes" class="monograph-section">
      <div class="monograph-grid">
        <SectionHeader eyebrow="05 / Notes" title="Recent Notes" />
        <div class="monograph-body">
          <NewsList entries={news} />
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .archive-disclosure {
    margin-block-start: 1.5rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--border);
  }

  .archive-compact {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.55rem;
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .archive-compact strong {
    color: var(--heading);
    font-weight: 500;
  }

  .archive-compact a {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--heading);
  }
</style>
